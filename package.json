{
  "name": "pf2e-combater",
  "version": "1.3.1",
  "main": "index.js",
  "directories": {
    "doc": "docs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/roi007leaf/pf2e-combater.git"
  },
  "author": "",
  "license": "GPL-3.0",
  "bugs": {
    "url": "https://github.com/roi007leaf/pf2e-combater/issues"
  },
  "homepage": "https://github.com/roi007leaf/pf2e-combater#readme",
  "description": "Floating tactical combat advisor for PF2e in Foundry VTT",
  "type": "module",
  "scripts": {
    "test": "node scripts/engine/self-test.js",
    "test:watch": "node scripts/engine/self-test.js",
    "test:coverage": "node scripts/engine/self-test.js",
    "test:ci": "node scripts/engine/self-test.js",
    "test:installed": "node scripts/engine/self-test/installed-runtime.test.js",
    "test:live": "node tests/live/run.mjs",
    "test:live:full": "node tests/live/run.mjs --full",
    "test:live:cleanup": "node tests/live/run.mjs --cleanup-only",
    "test:live:list": "node tests/live/run.mjs --list",
    "test:live:harness": "node --test tests/live/*.checks.mjs",
    "test:live:matrix": "node tests/live/matrix.mjs",
    "test:shipping": "npm test && npm run lint && npm run test:live:harness && npm run test:live:matrix --",
    "planner:quality": "node scripts/dev/run-planner-quality.mjs",
    "planner:quality:json": "node scripts/dev/run-planner-quality.mjs --json",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "build": "echo 'No build step required for Foundry VTT modules'",
    "prepublishOnly": "npm run test:ci && npm run lint",
    "prepare": "husky"
  },
  "devDependencies": {
    "@eslint/js": "^9.35.0",
    "classic-level": "^3.0.0",
    "eslint": "^9.35.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.4",
    "globals": "^16.3.0",
    "husky": "^9.1.7",
    "@inquirer/prompts": "^8.7.2",
    "playwright": "^1.63.0",
    "prettier": "^3.6.2"
  }
}
