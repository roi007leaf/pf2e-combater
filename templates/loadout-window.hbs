<div class="combater-loadout-shell">
  <p class="combater-loadout-help">{{help}}</p>

  <div class="combater-loadout-body">
    {{#if hasRecommendations}}
      {{#each recommendations}}
        <article class="combater-loadout-card {{#if best}}is-best{{/if}}">
          <div class="combater-loadout-swap" data-tooltip="{{summary}}">
            {{#if best}}<span class="combater-loadout-best"><i class="fa-solid fa-star"></i> {{bestLabel}}</span>{{/if}}
            <span class="combater-loadout-item is-held">
              {{#if heldItemImg}}<img src="{{heldItemImg}}" alt="">{{/if}}
              <span>{{heldItemName}}</span>
            </span>
            <i class="fa-solid fa-arrow-right" aria-hidden="true"></i>
            <span class="combater-loadout-item is-draw">
              {{#if drawItemImg}}<img src="{{drawItemImg}}" alt="">{{/if}}
              <strong>{{drawItemName}}</strong>
            </span>
          </div>
          <button type="button" class="combater-loadout-add" data-apply-loadout="{{id}}" data-tooltip="{{fitTooltip}}">
            <i class="fa-solid fa-plus"></i> {{addLabel}}
          </button>
          <ul class="combater-loadout-reasons">
            {{#each reasons}}<li>{{this}}</li>{{/each}}
          </ul>
        </article>
      {{/each}}
    {{else}}
      <p class="combater-loadout-empty"><i class="fa-solid fa-circle-check"></i> {{empty}}</p>
    {{/if}}
  </div>

  <footer class="combater-loadout-footer">
    <button type="button" data-loadout-close>{{closeLabel}}</button>
  </footer>
</div>
