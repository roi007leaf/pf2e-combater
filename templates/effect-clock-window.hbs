<div class="combater-effect-clock-shell">
  <div class="combater-effect-clock-body">
    {{#if hasEntries}}
      {{#each groups}}
        {{#if hasEntries}}
          <section class="combater-effect-clock-group is-{{id}}">
            <h3>{{label}} <span>{{entries.length}}</span></h3>
            <div class="combater-effect-clock-list">
              {{#each entries}}
                <article class="combater-effect-clock-entry is-{{kind}}">
                  <span class="combater-effect-clock-icon">
                    {{#if img}}<img src="{{img}}" alt="">{{else}}<i class="fa-solid fa-hourglass-half"></i>{{/if}}
                  </span>
                  <div class="combater-effect-clock-copy">
                    <strong>{{name}}</strong>
                    <span>{{detail}}</span>
                  </div>
                  <div class="combater-effect-clock-timing">
                    <strong>{{statusLabel}}</strong>
                    <span>{{timingLabel}}</span>
                  </div>
                  <div class="combater-effect-clock-actions">
                    {{#if canOpen}}
                      <button type="button" data-effect-clock-open="{{documentUuid}}" data-tooltip="{{@root.openLabel}}" aria-label="{{@root.openLabel}}: {{name}}">
                        <i class="fa-solid fa-book-open"></i>
                      </button>
                    {{/if}}
                  </div>
                </article>
              {{/each}}
            </div>
          </section>
        {{/if}}
      {{/each}}
    {{else}}
      <p class="combater-effect-clock-empty"><i class="fa-solid fa-circle-check"></i> {{empty}}</p>
    {{/if}}
  </div>

  <footer class="combater-effect-clock-footer">
    <button type="button" data-effect-clock-close>{{closeLabel}}</button>
  </footer>
</div>
