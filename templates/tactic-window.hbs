<div class="combater-tactic-shell">
  <p class="combater-tactic-help">{{help}}</p>

  <form class="combater-tactic-editor {{#if customEnabled}}is-custom{{/if}}" data-tactic-form>
    <section class="combater-tactic-choice-grid">
      <label class="combater-tactic-choice">
        <span>{{roleLabel}}</span>
        <select name="role">
          {{#each roles}}
            <option value="{{id}}" {{#if selected}}selected{{/if}}>{{label}}</option>
          {{/each}}
        </select>
      </label>

      {{#if showAdvanced}}
        <label class="combater-tactic-choice">
          <span>{{temperamentLabel}}</span>
          <select name="temperament">
            {{#each temperaments}}
              <option value="{{id}}" {{#if selected}}selected{{/if}}>{{label}}</option>
            {{/each}}
          </select>
        </label>
      {{/if}}
    </section>

    {{#if showAdvanced}}
      <label class="combater-tactic-custom-card">
        <span class="combater-tactic-custom-copy">
          <strong>{{customLabel}}</strong>
          <small>{{customHelp}}</small>
        </span>
        <input type="checkbox" role="switch" name="customEnabled" {{#if customEnabled}}checked{{/if}}>
      </label>

      <div class="combater-tactic-custom-fields" data-custom-sliders>
        {{#each sliderGroups}}
          <fieldset class="combater-tactic-fieldset">
            <legend>{{label}}</legend>
            {{#each sliders}}
              <div class="combater-tactic-slider" role="radiogroup" aria-label="{{label}}">
                <span>{{label}}</span>
                <span class="combater-tactic-steps">
                  {{#each steps}}
                    <label class="combater-tactic-step {{#if mid}}is-mid{{/if}} {{#if negative}}is-negative{{/if}}">
                      <input type="radio" name="{{../inputName}}" value="{{value}}" {{#if checked}}checked{{/if}}>
                      <span>{{label}}</span>
                    </label>
                  {{/each}}
                </span>
              </div>
            {{/each}}
            <div class="combater-tactic-scale" aria-hidden="true"><span>{{../avoidLabel}}</span><span>{{../presetLabel}}</span><span>{{../preferLabel}}</span></div>
          </fieldset>
        {{/each}}
      </div>
    {{/if}}
  </form>

  <footer class="combater-tactic-actions">
    <span class="combater-tactic-scope" role="radiogroup" aria-label="{{scopeLabel}}">
      <span>{{scopeLabel}}</span>
      <span class="combater-tactic-scope-options">
        <label class="combater-tactic-scope-option"><input type="radio" name="tacticSaveScope" value="token" checked><span>{{scopeTokenLabel}}</span></label>
        <label class="combater-tactic-scope-option"><input type="radio" name="tacticSaveScope" value="actor"><span>{{scopeActorLabel}}</span></label>
      </span>
    </span>
    <span class="combater-tactic-actions-gap"></span>
    <button type="button" class="combater-tactic-link" data-tactic-reset data-tooltip="{{resetLabel}}">{{resetShortLabel}}</button>
    <button type="button" class="combater-tactic-secondary" data-tactic-close>{{cancelLabel}}</button>
    <button type="button" class="combater-tactic-primary" data-tactic-save>{{saveLabel}}</button>
  </footer>
</div>
