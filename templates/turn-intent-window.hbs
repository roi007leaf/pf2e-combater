{{#*inline "keepButton"}}
  <button type="button" class="combater-turn-intent-lock {{#if active}}is-active{{/if}}" data-turn-intent-lock="{{key}}" aria-label="Keep {{label}} between turns" aria-pressed="{{#if active}}true{{else}}false{{/if}}" data-tooltip="Keep this rule for later turns" {{#if disabled}}disabled{{/if}}><i class="fa-solid {{#if active}}fa-lock{{else}}fa-lock-open{{/if}}"></i><span>Keep</span></button>
{{/inline}}
<form class="combater-turn-intent-form" data-turn-intent-form>
  <p class="combater-turn-intent-help">{{help}}</p>

  <div class="combater-turn-intent-list">
    <div class="combater-turn-intent-decision">
      <label class="combater-turn-intent-option {{#unless canLockTarget}}is-disabled{{/unless}}">
        <input type="checkbox" role="switch" name="lockTarget" {{#if lockTarget}}checked{{/if}} {{#unless canLockTarget}}disabled{{/unless}}>
        <span>
          <strong>Lock target</strong>
          <small>{{targetLabel}}</small>
        </span>
      </label>
      {{> keepButton key="lockedTargetIds" label="target choice" active=intent.decisionLocks.lockedTargetIds disabled=lockTargetDisabled}}
    </div>

    <div class="combater-turn-intent-decision is-field">
      <div class="combater-turn-intent-option combater-turn-intent-field">
        <span class="combater-turn-intent-must">
          <strong>Must include</strong>
          <span class="combater-pick-search"><i class="fa-solid fa-magnifying-glass" aria-hidden="true"></i><input type="search" data-turn-intent-search placeholder="Search actions" aria-label="Search actions" autocomplete="off"></span>
          <span class="combater-pick-scroll">
            <span class="combater-pick-grid" data-turn-intent-actions role="radiogroup" aria-label="Must include">
              <label class="combater-pick-card is-gold" data-pick-search="any action">
                <input type="radio" name="requiredActionKey" value="" {{#unless intent.requiredActionKey}}checked{{/unless}}>
                <span class="combater-pick-art"><i class="fa-solid fa-shuffle" aria-hidden="true"></i></span>
                <span class="combater-pick-text"><strong>Any action</strong><small>No requirement</small></span>
                <i class="fa-solid fa-circle-check combater-pick-check" aria-hidden="true"></i>
              </label>
              {{#each actionOptions}}
                <label class="combater-pick-card" data-pick-search="{{name}}">
                  <input type="radio" name="requiredActionKey" value="{{key}}" {{#if selected}}checked{{/if}}>
                  <span class="combater-pick-art">{{#if img}}<img src="{{img}}" alt="">{{else}}<i class="fa-solid fa-bolt" aria-hidden="true"></i>{{/if}}</span>
                  <span class="combater-pick-text"><strong>{{name}}</strong>{{#if detail}}<small>{{detail}}</small>{{/if}}</span>
                  <i class="fa-solid fa-circle-check combater-pick-check" aria-hidden="true"></i>
                </label>
              {{/each}}
            </span>
          </span>
        </span>
      </div>
    </div>

    <div class="combater-turn-intent-decision">
      <label class="combater-turn-intent-option">
        <input type="checkbox" role="switch" name="noSpellSlots" {{#if intent.noSpellSlots}}checked{{/if}}>
        <span><strong>No spell slots</strong><small>Cantrips and focus spells still allowed.</small></span>
      </label>
      {{> keepButton key="noSpellSlots" label="No spell slots" active=intent.decisionLocks.noSpellSlots}}
    </div>
    <div class="combater-turn-intent-decision">
      <label class="combater-turn-intent-option">
        <input type="checkbox" role="switch" name="stayRanged" {{#if intent.stayRanged}}checked{{/if}}>
        <span><strong>Stay ranged</strong><small>No melee attacks or maneuvers.</small></span>
      </label>
      {{> keepButton key="stayRanged" label="Stay ranged" active=intent.decisionLocks.stayRanged}}
    </div>
    <div class="combater-turn-intent-decision">
      <label class="combater-turn-intent-option">
        <input type="checkbox" role="switch" name="endInCover" {{#if intent.endInCover}}checked{{/if}}>
        <span><strong>End in cover</strong><small>Moves, and ends the turn behind cover.</small></span>
      </label>
      {{> keepButton key="endInCover" label="End in cover" active=intent.decisionLocks.endInCover}}
    </div>
    <div class="combater-turn-intent-decision">
      <label class="combater-turn-intent-option">
        <input type="checkbox" role="switch" name="preserveFinalAction" {{#if intent.preserveFinalAction}}checked{{/if}}>
        <span><strong>Save an action</strong><small>Plan one fewer normal action.</small></span>
      </label>
      {{> keepButton key="preserveFinalAction" label="Save an action" active=intent.decisionLocks.preserveFinalAction}}
    </div>
  </div>

  <footer class="combater-turn-intent-actions">
    <button type="button" class="combater-turn-intent-clear" data-turn-intent-clear><i class="fa-solid fa-eraser"></i> Clear all</button>
    <span></span>
    <button type="button" data-turn-intent-cancel>Cancel</button>
    <button type="button" class="is-primary" data-turn-intent-save data-apply-label="Apply" data-apply-count-label="Apply · {count} rules"><i class="fa-solid fa-check"></i> <span data-turn-intent-apply-label>Apply</span></button>
  </footer>
</form>
