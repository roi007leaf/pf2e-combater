<div class="combater-browser-shell{{#if compact}} is-compact{{/if}}">
  {{#if builder}}
    {{#*inline "actionRows"}}
      {{#each actions}}
        <div class="combater-alt-step combater-action-row combater-browser-row {{#if favorite}}is-favorite{{/if}} {{#if disabled}}is-disabled{{/if}} {{#if userExcluded}}is-excluded{{/if}} {{#if overBudget}}is-over{{/if}} {{#if expanded}}is-expanded{{/if}}" {{#if canDragFavorite}}data-drag-row="{{favoriteEntryKey}}"{{/if}}>
          {{#unless readonly}}
          <button type="button" class="combater-run combater-favorite {{#if favorite}}is-active{{/if}}" data-favorite-action="{{key}}" data-tooltip="{{favoriteTitle}}" aria-label="{{favoriteTitle}}">
            <i class="{{#if favorite}}fa-solid fa-star{{else}}fa-regular fa-star{{/if}}"></i>
          </button>
          {{/unless}}
          {{#if img}}<img class="combater-browser-icon" src="{{img}}" alt="">{{else}}<span class="combater-browser-icon"></span>{{/if}}
          <button type="button" class="combater-browser-main" data-expand-action="{{key}}" aria-expanded="{{#if expanded}}true{{else}}false{{/if}}" aria-label="{{@root.labels.expand}}: {{name}}">
            <span class="combater-browser-name">{{name}}</span>
            <span class="combater-browser-why">{{#if userExcluded}}<span class="is-warning"><i class="fa-solid fa-eye-slash" aria-hidden="true"></i> {{localize "PF2E_COMBATER.Browser.HiddenForPlayers"}}</span> · {{/if}}{{#if rowTarget}}<span class="is-target">{{rowTarget}}</span> · {{/if}}{{#if rowWarning}}<span class="is-warning">{{rowWarning}}</span>{{else}}{{reason}}{{/if}}</span>
          </button>
          {{#if recharge}}
          <span class="combater-browser-recharge" data-tooltip="{{recharge.tooltip}}"><i class="fa-solid fa-hourglass-half" aria-hidden="true"></i>{{recharge.rounds}}</span>
          {{else}}
          <span class="combater-browser-odds"{{#if oddsTooltipHtml}} data-tooltip-html="{{oddsTooltipHtml}}"{{else}}{{#if oddsTooltip}} data-tooltip="{{oddsTooltip}}"{{/if}}{{/if}}>{{odds}}</span>
          {{/if}}
          {{#unless readonly}}
            {{#unless blockedByExclusion}}
            <button type="button" class="combater-run combater-add-action {{#if overBudget}}is-over{{/if}}" data-add-action="{{key}}" data-tooltip="{{addTooltip}}" aria-label="{{localize "PF2E_COMBATER.Browser.AddToPlanAria" name=name}}" {{#if overBudget}}disabled{{/if}}>
              <i class="fa-solid fa-plus"></i>
            </button>
            {{/unless}}
            {{#if canDragFavorite}}
              <span class="combater-chip-tool combater-step-drag" data-drag-favorite="{{favoriteEntryKey}}" draggable="true" data-tooltip="{{localize "PF2E_COMBATER.Panel.DragToReorder"}}" aria-label="{{localize "PF2E_COMBATER.Panel.DragToReorderAria" name=name}}">
                <i class="fa-solid fa-grip-vertical"></i>
              </span>
            {{/if}}
          {{/unless}}
          {{#if expanded}}
            <div class="combater-browser-detail">
              {{#if targetLabel}}<p class="combater-browser-detail-target">{{targetLabel}}</p>{{/if}}
              {{#if hasExtraChips}}
                <div class="combater-detail-chips" aria-label="{{localize "PF2E_COMBATER.Browser.ActionDetailsAria"}}">
                  {{#each extraChips}}
                    <span class="combater-detail-chip {{class}}"{{#if tooltipHtml}} data-tooltip-html="{{tooltipHtml}}"{{else}} data-tooltip="{{tooltip}}"{{/if}}>{{label}}</span>
                  {{/each}}
                </div>
              {{/if}}
              <div class="combater-browser-detail-actions">
                {{#unless readonly}}
                  {{#unless blockedByExclusion}}{{#unless hideUncounted}}
                  <button type="button" class="combater-add-uncounted" data-add-uncounted="{{key}}" data-tooltip="{{localize "PF2E_COMBATER.Browser.AddUncounted"}}" aria-label="{{localize "PF2E_COMBATER.Browser.AddUncountedAria" name=name}}"><i class="fa-solid fa-bolt"></i> {{@root.labels.addUncounted}}</button>
                  {{/unless}}{{/unless}}
                  <button type="button" data-exclude-action="{{key}}" data-tooltip="{{#if userExcluded}}{{localize "PF2E_COMBATER.Browser.RestoreAction"}}{{else}}{{localize "PF2E_COMBATER.Browser.HideAction"}}{{/if}}"><i class="fa-solid {{#if userExcluded}}fa-eye{{else}}fa-eye-slash{{/if}}"></i> {{#if userExcluded}}{{@root.labels.restore}}{{else}}{{@root.labels.hide}}{{/if}}</button>
                {{/unless}}
                <button type="button" data-open-action="{{key}}" data-tooltip="{{localize "PF2E_COMBATER.Browser.OpenDetails"}}"><i class="fa-solid fa-book-open"></i> {{@root.labels.openSheet}}</button>
              </div>
            </div>
          {{/if}}
        </div>
      {{else}}
        {{#if isFavoritesSection}}
          <p class="combater-empty combater-favorites-hint">{{@root.labels.favoritesHint}}</p>
        {{else}}
          <p class="combater-empty">{{localize "PF2E_COMBATER.Browser.NoActions"}}</p>
        {{/if}}
      {{/each}}
    {{/inline}}
    {{#*inline "actionTiles"}}
      <div class="combater-browser-tiles">
      {{#each actions}}
        <button type="button" class="combater-browser-tile{{#if favorite}} is-favorite{{/if}}{{#if disabled}} is-disabled{{/if}}{{#if userExcluded}} is-excluded{{/if}}{{#if overBudget}} is-over{{/if}}"{{#unless readonly}}{{#unless blockedByExclusion}} data-tile-add="{{key}}"{{#if overBudget}} data-tile-over{{/if}}{{#if hideUncounted}} data-tile-no-uncounted{{/if}}{{/unless}} data-tile-favorite="{{key}}"{{/unless}} data-tooltip="{{tileTooltip}}" aria-label="{{tileTooltip}}">
          {{#if tileImg}}<img src="{{tileImg}}" alt="">{{/if}}
          <span class="combater-browser-tile-name">{{name}}</span>
          {{#if favorite}}<i class="fa-solid fa-star combater-browser-tile-star" aria-hidden="true"></i>{{/if}}
          {{#if recharge}}<span class="combater-browser-tile-badge is-recharge"><i class="fa-solid fa-hourglass-half" aria-hidden="true"></i>{{recharge.rounds}}</span>{{else if odds}}<span class="combater-browser-tile-badge">{{odds}}</span>{{/if}}
        </button>
      {{else}}
        {{#if isFavoritesSection}}
          <p class="combater-empty combater-favorites-hint">{{@root.labels.favoritesHint}}</p>
        {{else}}
          <p class="combater-empty">{{localize "PF2E_COMBATER.Browser.NoActions"}}</p>
        {{/if}}
      {{/each}}
      </div>
    {{/inline}}
    <div class="combater-browser-header">
      <nav class="combater-tabs" aria-label="{{localize "PF2E_COMBATER.Browser.TabsAria"}}">
        {{#each builder.tabsList}}
          <button type="button" data-tab="{{id}}" class="{{#if active}}active{{/if}}"{{#if @root.compact}} data-tooltip="{{label}}" aria-label="{{label}}"{{/if}}>
            <img class="combater-tab-glyph" src="{{glyphIcon}}" alt="">
            <span>{{label}}</span>
            <span class="combater-tab-count">{{count}}</span>
          </button>
        {{/each}}
      </nav>
      <div class="combater-browser-toolbar">
        <div class="combater-search">
          <i class="fa-solid fa-magnifying-glass" aria-hidden="true"></i>
          <input type="search" data-search-actions value="{{builder.searchQuery}}" placeholder="{{localize "PF2E_COMBATER.Browser.SearchPlaceholder" label=builder.activeTabLabel}}" aria-label="{{localize "PF2E_COMBATER.Browser.SearchAria" label=builder.activeTabLabel}}" autocomplete="off">
        </div>
        {{#unless readonly}}
        <button type="button" class="combater-browser-toggle" data-show-excluded aria-pressed="{{showExcluded}}" data-tooltip="{{localize "PF2E_COMBATER.Browser.ShowHidden"}}"><i class="fa-solid fa-eye-slash"></i><span class="combater-browser-toggle-label"> {{hiddenLabel}}</span></button>
        {{/unless}}
        <button type="button" class="combater-browser-toggle" data-browser-sort data-tooltip="{{sortTooltip}}{{#if compact}}: {{sortLabel}}{{/if}}"><i class="fa-solid fa-arrow-down-wide-short"></i><span class="combater-browser-toggle-label"> {{sortLabel}}</span></button>
        <button type="button" class="combater-browser-toggle is-compact-toggle" data-browser-compact aria-pressed="{{#if compact}}true{{else}}false{{/if}}" data-tooltip="{{compactTooltip}}" aria-label="{{compactTooltip}}"><i class="fa-solid {{#if compact}}fa-list{{else}}fa-table-cells{{/if}}"></i></button>
      </div>
      {{#if browserBar}}
      <div class="combater-browser-bar {{#if browserBar.over}}is-over{{/if}}">
        {{#if browserBar.pips.length}}<span class="combater-browser-pips" aria-hidden="true">{{#each browserBar.pips}}<span class="action-glyph">1</span>{{/each}}</span>{{/if}}
        <span><strong>{{browserBar.remainingLabel}}</strong>{{#if browserBar.overLabel}} · {{browserBar.overLabel}}{{/if}}</span>
        {{#if browserBar.sharedTarget}}<span class="combater-browser-bar-target">{{browserBar.sharedTargetLabel}} <strong>{{browserBar.sharedTarget}}</strong></span>{{/if}}
      </div>
      {{/if}}
    </div>

    <section class="combater-body">
      <div class="combater-plan-list">
        {{#if builder.searchQuery}}
          {{#each builder.mergedSearchResults}}
            <article class="combater-alt combater-builder-card combater-action-section">
              <div class="combater-alt-head">
                <span class="combater-alt-title">
                  <strong>{{label}}</strong>
                  <span class="combater-section-tag">{{tabLabel}}</span>
                  {{#if countLabel}}<span class="combater-section-count">{{countLabel}}</span>{{/if}}
                </span>
              </div>
              <div class="combater-alt-details" {{#if isFavoritesSection}}data-drag-list{{/if}}>
                {{#if @root.compact}}{{> actionTiles}}{{else}}{{> actionRows}}{{/if}}
              </div>
            </article>
          {{else}}
            <p class="combater-empty">{{localize "PF2E_COMBATER.Browser.NoActions"}}</p>
          {{/each}}
        {{else}}
          {{#each builder.tabsList}}
            {{#if active}}
              {{#each sections}}
                <article class="combater-alt combater-builder-card combater-action-section">
                  <div class="combater-alt-head">
                    <span class="combater-alt-title">
                      <strong>{{label}}</strong>
                      {{#if countLabel}}<span class="combater-section-count">{{countLabel}}</span>{{/if}}
                    </span>
                  </div>
                  <div class="combater-alt-details" {{#if isFavoritesSection}}data-drag-list{{/if}}>
                    {{#if @root.compact}}{{> actionTiles}}{{else}}{{> actionRows}}{{/if}}
                  </div>
                </article>
              {{/each}}
            {{/if}}
          {{/each}}
        {{/if}}

        {{#if showDebug}}
          <div class="combater-debug">
            <details>
              <summary>{{localize "PF2E_COMBATER.Browser.DebugCandidates" count=debug.candidates.length}}</summary>
              {{#each debug.candidates}}
                <div class="debug-row">
                  <span>{{name}}</span>
                  <code data-tooltip="{{profile}}">{{source}}{{#if role}}/{{role}}{{/if}}</code>
                  <span>{{costLabel}}</span>
                  <span>{{#if skillCheckLabel}}{{skillCheckLabel}}{{else}}{{#if targetLabel}}{{targetLabel}}{{else}}{{score}}{{/if}}{{/if}}</span>
                </div>
              {{/each}}
            </details>
            <details>
              <summary>{{localize "PF2E_COMBATER.Browser.DebugRejected" count=debug.rejected.length}}</summary>
              {{#each debug.rejected}}
                <div class="debug-row">
                  <span>{{action.name}}</span>
                  <code data-tooltip="{{action.source}}">{{action.source}}</code>
                  <span>{{reason}}</span>
                </div>
              {{/each}}
            </details>
            <details>
              <summary>{{localize "PF2E_COMBATER.Browser.DebugDetected" count=debug.detected.length}}</summary>
              {{#each debug.detected}}
                <div class="debug-row">
                  <span>{{name}}</span>
                  <code data-tooltip="{{profile}}">{{source}}{{#if role}}/{{role}}{{/if}}</code>
                  <span>{{costLabel}}</span>
                  <span>{{#if available}}{{localize "PF2E_COMBATER.Browser.Available"}}{{else}}{{localize "PF2E_COMBATER.Browser.Blocked"}}{{/if}}</span>
                </div>
              {{/each}}
            </details>
          </div>
        {{/if}}
      </div>
    </section>
  {{else}}
    <section class="combater-body">
      <p class="combater-empty">{{localize "PF2E_COMBATER.Browser.NoContext"}}</p>
    </section>
  {{/if}}
</div>
