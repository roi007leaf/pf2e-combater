<div class="combater-shell{{#unless expanded}} is-compact{{/unless}}">
  {{#*inline "minionPlanDetails"}}
    {{#if minionPlan}}
      <span class="combater-minion-subturn" data-tooltip="{{minionPlan.label}}">
        <span class="combater-minion-subturn-head"><i class="fa-solid fa-paw"></i> {{minionPlan.minionName}}</span>
        {{#each minionPlan.steps}}
          {{#if canCycle}}
            <span class="combater-minion-step is-editable" role="button" tabindex="0" data-cycle-minion-step="{{cycleInstanceId}}" data-minion-step-index="{{cycleIndex}}" data-tooltip="{{tooltip}}" aria-label="{{tooltip}}">
              <span class="combater-minion-step-index">{{position}}</span>{{name}}
            </span>
          {{else}}
            <span class="combater-minion-step"><span class="combater-minion-step-index">{{position}}</span>{{name}}</span>
          {{/if}}
        {{/each}}
        {{#if minionPlan.targetName}}<span class="combater-minion-target">vs {{minionPlan.targetName}}</span>{{/if}}
      </span>
    {{else}}
      {{#if minionPlanLabel}}<span class="combater-detail-chip is-minion-plan"><i class="fa-solid fa-paw"></i> {{minionPlanLabel}}</span>{{/if}}
    {{/if}}
  {{/inline}}
  {{#*inline "draftSequence"}}
  {{#*inline "draftStepChip"}}
          <div class="combater-header-step {{#if warning}}has-warning{{/if}} status-{{executionStatus}} {{#if isCurrentExecution}}is-current{{/if}} {{#if toolsOpen}}is-tools-open{{/if}}" data-preview-draft-step="{{instanceId}}" data-drag-row="{{instanceId}}"{{#if pipSlots}} data-step-pips="{{pipSlots}}"{{/if}}>
            <button type="button" class="combater-chip {{costClass}}" data-open-draft-step="{{instanceId}}" data-tooltip="{{name}}{{#if mapLabel}} ({{mapLabel}}){{/if}}{{#if targetLabel}} - {{targetLabel}}{{/if}}{{#if areaLabel}} - {{areaLabel}}{{/if}}{{#if executionLabel}} - {{executionLabel}}{{/if}}{{#if warning}} - {{warning}}{{/if}}: {{reason}}">
              {{#if stepNumber}}<span class="combater-step-number" aria-hidden="true"><span>{{stepNumber}}</span></span>{{/if}}
              {{#unless isGroupChild}}
              <span class="combater-chip-cost" aria-label="{{costLabel}}">
                <img class="combater-cost-glyph" src="{{actionGlyphIcon}}" alt="{{costLabel}}">
              </span>
              {{/unless}}
              <span class="combater-step-main">
                <span class="combater-step-headline">
                  {{#if img}}<img class="combater-chip-img" src="{{img}}" alt="">{{/if}}
                  <span class="combater-chip-name">{{name}}</span>
                  {{#if usesQuickened}}<span class="combater-exec-badge is-quickened" data-tooltip="{{quickenedActionHint}}"><i class="fa-solid fa-bolt" aria-hidden="true"></i> {{quickenedActionLabel}}</span>{{/if}}
                  {{#if quickenedNextTurn}}<span class="combater-exec-badge is-next-turn" data-tooltip="{{quickenedNextTurnHint}}">{{quickenedNextTurnLabel}}</span>{{/if}}
                  {{#if isExecutionDone}}<span class="combater-exec-badge is-done"><i class="fa-solid fa-check"></i> {{localize "PF2E_COMBATER.Panel.Done"}}</span>{{/if}}
                  {{#if isExecutionFailed}}<span class="combater-exec-badge is-failed" data-tooltip="{{executionTooltip}}"><i class="fa-solid fa-triangle-exclamation"></i> {{localize "PF2E_COMBATER.Panel.Failed"}}</span>{{/if}}
                </span>
                {{#if hasStepDetails}}
                <span class="combater-step-details {{#if minionPlan}}has-minion-plan{{/if}}">
                  {{#if targetLabel}}{{#unless hideTarget}}<span class="combater-chip-target{{#if canOpenTargetIntel}} is-intel-target{{/if}}"{{#if canOpenTargetIntel}} data-open-target-intel="{{targetIntelKey}}" data-tooltip="{{targetIntelTooltip}}"{{/if}}>{{targetLabel}}</span>{{/unless}}{{/if}}
                  {{#if areaLabel}}<span class="combater-chip-target">{{areaLabel}}</span>{{/if}}
                  {{#if swapItemsLabel}}<span class="combater-detail-chip is-swap-items"><i class="fa-solid fa-right-left"></i> {{swapItemsLabel}}</span>{{/if}}
                  {{#if isRanged}}<span class="combater-detail-chip is-range"><i class="fa-solid fa-crosshairs"></i> {{rangeLabel}}</span>{{/if}}
                  {{#unless minionPlanAsChildren}}{{> minionPlanDetails}}{{/unless}}
                  {{#if awaitingGm}}<span class="combater-chip-target is-awaiting"><i class="fa-solid fa-hourglass-half fa-spin"></i> {{awaitingGmLabel}}</span>{{/if}}
                  {{#if warning}}<span class="combater-chip-target is-warning"><i class="fa-solid fa-triangle-exclamation"></i> {{warning}}</span>{{/if}}
                  {{#if hasTraitChips}}
                    {{#each traitChips}}
                      <span class="combater-detail-chip {{class}}"{{#if tooltipHtml}} data-tooltip-html="{{tooltipHtml}}"{{else}} data-tooltip="{{tooltip}}"{{/if}}>{{label}}</span>
                    {{/each}}
                    {{#if traitOverflow}}<span class="combater-detail-chip is-trait-overflow" data-tooltip="{{traitOverflow.tooltip}}">{{traitOverflow.label}}</span>{{/if}}
                  {{/if}}
                </span>
                {{/if}}
              </span>
            </button>
            <span class="combater-step-tools">
              {{#if canDragStep}}
                <span class="combater-chip-tool combater-step-drag" data-drag-draft-step="{{instanceId}}" draggable="true" data-tooltip="{{localize "PF2E_COMBATER.Panel.DragToReorder"}}" aria-label="{{localize "PF2E_COMBATER.Panel.DragToReorderAria" name=name}}">
                  <i class="fa-solid fa-grip-vertical"></i>
                </span>
              {{/if}}
              {{#unless isExecutionDone}}
                {{#if canCycleMap}}
                  <button type="button" class="combater-chip-tool combater-map-cycle {{#if mapPinned}}is-pinned{{/if}} {{#if attackBonusLabel}}has-bonus{{/if}}" data-cycle-map="{{instanceId}}" data-tooltip="{{mapToolTip}}" aria-label="{{mapToolTip}}">
                    {{#if attackBonusLabel}}<span class="combater-attack-bonus">{{attackBonusLabel}}</span><span class="combater-map-value">{{mapToolLabel}}</span>{{else}}<i class="fa-solid fa-burst"></i><span class="combater-map-value">{{mapToolLabel}}</span>{{/if}}
                  </button>
                {{/if}}
                {{#if awaitingGm}}
                <span class="combater-chip-tool combater-step-waiting" data-tooltip="{{awaitingGmLabel}}" aria-label="{{awaitingGmLabel}}">
                  <i class="fa-solid fa-hourglass-half fa-spin"></i>
                </span>
                {{else}}
                {{#if canShowExecuteStep}}
                <button type="button" class="combater-chip-tool combater-step-run is-execute {{#if executionBlocked}}is-disabled{{/if}}" data-execute-draft-step="{{instanceId}}" data-tooltip="{{executeTooltip}}" aria-label="{{executeTooltip}}" {{#if executionBlocked}}disabled{{/if}}>
                  <i class="fa-solid fa-play"></i>
                </button>
                {{/if}}
                {{/if}}
              {{/unless}}
              {{#if isExecutionDone}}
                {{#if canRevertStep}}
                <button type="button" class="combater-chip-tool combater-step-run is-revert" data-revert-step="{{instanceId}}" data-tooltip="{{localize "PF2E_COMBATER.Panel.RevertStep"}}" aria-label="{{localize "PF2E_COMBATER.Panel.RevertStep"}}">
                  <i class="fa-solid fa-rotate-left"></i>
                </button>
                {{/if}}
              {{/if}}
              {{#if hasMoreTools}}
                <button type="button" class="combater-chip-tool combater-step-more-toggle" data-step-more="{{instanceId}}" aria-expanded="{{#if toolsOpen}}true{{else}}false{{/if}}" data-tooltip="{{moreToolsLabel}}" aria-label="{{moreToolsLabel}}">
                  <i class="fa-solid fa-ellipsis"></i>
                </button>
              {{/if}}
            </span>
            {{#if hasMoreTools}}
            <span class="combater-step-more-tools">
              {{#unless isExecutionDone}}
                {{#if canChooseSummon}}
                  <button type="button" class="combater-chip-tool" data-choose-summon="{{instanceId}}" data-tooltip="{{localize "PF2E_COMBATER.Summon.Choose"}}" aria-label="{{localize "PF2E_COMBATER.Summon.Choose"}}"><i class="fa-solid fa-paw"></i></button>
                {{/if}}
                {{#if summonLabel}}<span class="combater-chip-target">{{summonLabel}}</span>{{/if}}
                {{#if canChooseTarget}}
                  <button type="button" class="combater-chip-tool has-label" data-choose-target="{{instanceId}}" data-tooltip="{{targetToolTip}}" aria-label="{{targetToolTip}}">
                    <i class="fa-solid fa-crosshairs"></i><span>{{moreToolsTargetLabel}}</span>
                  </button>
                {{/if}}
                {{#if canChooseDestination}}
                  <button type="button" class="combater-chip-tool" data-choose-destination="{{instanceId}}" data-tooltip="{{localize "PF2E_COMBATER.Panel.SetDestination"}}" aria-label="{{localize "PF2E_COMBATER.Panel.SetDestination"}}">
                    <i class="fa-solid fa-location-crosshairs"></i>
                  </button>
                {{/if}}
                {{#if canChooseArea}}
                  <button type="button" class="combater-chip-tool" data-choose-area="{{instanceId}}" data-tooltip="{{localize "PF2E_COMBATER.Panel.SetTemplate"}}" aria-label="{{localize "PF2E_COMBATER.Panel.SetTemplate"}}">
                    <i class="fa-solid fa-draw-polygon"></i>
                  </button>
                {{/if}}
                {{#if canChooseRecommendedArea}}
                  <button type="button" class="combater-chip-tool combater-area-placement" data-choose-recommended-area="{{instanceId}}" data-tooltip="{{areaPlacementToolTip}}" aria-label="{{areaPlacementToolTip}}">
                    <i class="fa-solid fa-bullseye"></i><span class="combater-area-placement-value">{{areaPlacementToolLabel}}</span>
                  </button>
                {{/if}}
                {{#if canChooseSwapItems}}
                  <button type="button" class="combater-chip-tool" data-choose-swap-items="{{instanceId}}" data-tooltip="{{swapItemsTooltip}}" aria-label="{{swapItemsTooltip}}">
                    <i class="fa-solid fa-right-left"></i>
                  </button>
                {{/if}}
                {{#if canCycleMovement}}
                  <button type="button" class="combater-chip-tool combater-movement-cycle" data-cycle-movement="{{instanceId}}" data-tooltip="{{movementToolTip}}" aria-label="{{movementToolTip}}">
                    <i class="fa-solid fa-shoe-prints"></i><span class="combater-movement-value">{{movementToolLabel}}</span>
                  </button>
                {{/if}}
                {{#if canCycleRoute}}
                  <button type="button" class="combater-chip-tool combater-route-cycle" data-cycle-route="{{instanceId}}" data-tooltip="{{routeModeToolTip}}" aria-label="{{routeModeToolTip}}">
                    <i class="fa-solid fa-route"></i><span class="combater-route-value">{{routeModeLabel}}</span>
                  </button>
                {{/if}}
                {{#if canCycleDestination}}
                  <button type="button" class="combater-chip-tool combater-destination-cycle" data-cycle-destination="{{instanceId}}" data-tooltip="{{movementAlternativeToolTip}}" aria-label="{{movementAlternativeToolTip}}">
                    <i class="fa-solid fa-location-crosshairs"></i><span class="combater-destination-value">{{movementAlternativeToolLabel}}</span>
                  </button>
                {{/if}}
                {{#if canCycleWeapon}}
                  <button type="button" class="combater-chip-tool combater-weapon-cycle" data-cycle-weapon="{{instanceId}}" data-tooltip="{{weaponToolTip}}" aria-label="{{weaponToolTip}}">
                    <i class="fa-solid fa-khanda"></i><span class="combater-weapon-value">{{weaponToolLabel}}</span>
                  </button>
                {{/if}}
              {{/unless}}
              {{!-- Remove template stays available after execution so a placed region can be cleared. --}}
              {{#if hasAreaMarker}}
                {{#unless readonly}}
                <button type="button" class="combater-chip-tool" data-remove-area="{{instanceId}}" data-tooltip="{{localize "PF2E_COMBATER.Panel.RemoveTemplate"}}" aria-label="{{localize "PF2E_COMBATER.Panel.RemoveTemplate"}}">
                  <i class="fa-solid fa-eraser"></i>
                </button>
                {{/unless}}
              {{/if}}
              {{#if canDuplicateStep}}
                <button type="button" class="combater-chip-tool has-label" data-duplicate-draft-step="{{instanceId}}" data-tooltip="{{localize "PF2E_COMBATER.Panel.DuplicateStep"}}" aria-label="{{localize "PF2E_COMBATER.Panel.DuplicateStepAria" name=name}}">
                  <i class="fa-solid fa-clone"></i><span>{{moreToolsDuplicateLabel}}</span>
                </button>
              {{/if}}
              {{#if canRemoveDraftStep}}
              <button type="button" class="combater-chip-tool danger has-label" data-remove-draft-step="{{instanceId}}" data-tooltip="{{localize "PF2E_COMBATER.Panel.Remove"}}" aria-label="{{localize "PF2E_COMBATER.Panel.Remove"}}">
                <i class="fa-solid fa-trash"></i><span>{{moreToolsRemoveLabel}}</span>
              </button>
              {{/if}}
            </span>
            {{/if}}
            {{#if why.hasReasons}}
              <details class="combater-step-why" data-tooltip="{{why.tooltip}}">
                <summary>
                  <i class="fa-solid fa-lightbulb"></i>
                  <span class="combater-step-why-summary">{{why.summary}}</span>
                  {{#if why.stars}}<span class="combater-step-why-stars" aria-label="{{why.scoreLabel}}">{{#each why.stars}}<i class="fa-solid fa-star {{#unless on}}is-off{{/unless}}"></i>{{/each}}</span>{{/if}}
                </summary>
                <ul>
                  {{#each why.reasons}}
                    <li>{{this}}</li>
                  {{/each}}
                </ul>
              </details>
            {{/if}}
          </div>
          {{#if minionPlanAsChildren}}
            <span class="combater-minion-action-list">
              {{#each minionPlan.steps}}
                <span class="combater-header-step combater-minion-action-row" data-preview-minion-step="{{cycleInstanceId}}" data-minion-step-index="{{cycleIndex}}">
                  <button type="button" class="combater-chip combater-minion-action-chip" {{#if canCycle}}data-cycle-minion-step="{{cycleInstanceId}}" data-minion-step-index="{{cycleIndex}}"{{/if}} data-tooltip="{{tooltip}}" aria-label="{{tooltip}}">
                    <span class="combater-chip-cost is-minion-child" aria-label="{{position}}">
                      <span class="combater-minion-step-index">{{position}}</span>
                    </span>
                    <span class="combater-step-main">
                      <span class="combater-step-headline">
                        <i class="fa-solid fa-paw"></i>
                        <span class="combater-chip-name">{{name}}</span>
                      </span>
                      {{#if targetLabel}}
                        <span class="combater-step-details">
                          <span class="combater-chip-target">{{targetLabel}}</span>
                        </span>
                      {{/if}}
                      {{#if destinationLabel}}
                        <span class="combater-step-details">
                          <span class="combater-chip-target">{{destinationLabel}}</span>
                        </span>
                      {{/if}}
                    </span>
                  </button>
                  <span class="combater-step-tools">
                    {{#if canChooseTarget}}
                      <button type="button" class="combater-chip-tool" data-choose-minion-target="{{cycleInstanceId}}" data-minion-step-index="{{cycleIndex}}" data-tooltip="{{chooseTargetTooltip}}" aria-label="{{chooseTargetTooltip}}">
                        <i class="fa-solid fa-crosshairs"></i>
                      </button>
                    {{/if}}
                    {{#if canChooseDestination}}
                      <button type="button" class="combater-chip-tool" data-choose-minion-destination="{{cycleInstanceId}}" data-minion-step-index="{{cycleIndex}}" data-tooltip="{{chooseDestinationTooltip}}" aria-label="{{chooseDestinationTooltip}}">
                        <i class="fa-solid fa-location-crosshairs"></i>
                      </button>
                    {{/if}}
                    {{#if canShowMovementControl}}
                      <button type="button" class="combater-chip-tool combater-movement-cycle {{#unless canCycleMovement}}is-readonly{{/unless}}" {{#if canCycleMovement}}data-cycle-minion-movement="{{cycleInstanceId}}" data-minion-step-index="{{cycleIndex}}"{{else}}disabled{{/if}} data-tooltip="{{movementToolTip}}" aria-label="{{movementToolTip}}">
                        <i class="fa-solid fa-shoe-prints"></i><span class="combater-movement-value">{{movementToolLabel}}</span>
                      </button>
                    {{/if}}
                    {{#if canExecute}}
                      <button type="button" class="combater-chip-tool combater-step-run is-execute {{#if executionBlocked}}is-disabled{{/if}}" data-execute-minion-step="{{cycleInstanceId}}" data-minion-step-index="{{cycleIndex}}" data-tooltip="{{executeTooltip}}" aria-label="{{executeTooltip}}" {{#if executionBlocked}}disabled{{/if}}>
                        <i class="fa-solid fa-play"></i>
                      </button>
                    {{/if}}
                    {{#if canRevertStep}}
                      <button type="button" class="combater-chip-tool combater-step-run is-revert" data-revert-minion-step="{{cycleInstanceId}}" data-minion-step-index="{{cycleIndex}}" data-tooltip="{{revertTooltip}}" aria-label="{{revertTooltip}}">
                        <i class="fa-solid fa-rotate-left"></i>
                      </button>
                    {{/if}}
                    {{#if canRemoveStep}}
                      <button type="button" class="combater-chip-tool danger" data-remove-minion-step="{{cycleInstanceId}}" data-minion-step-index="{{cycleIndex}}" data-tooltip="{{removeTooltip}}" aria-label="{{removeTooltip}}">
                        <i class="fa-solid fa-trash"></i>
                      </button>
                    {{/if}}
                  </span>
                </span>
              {{/each}}
            </span>
          {{/if}}
  {{/inline}}
  <div class="combater-plan-strip">
    {{#if planLayout.sharedTarget}}
      <div class="combater-shared-target">
        <i class="fa-solid fa-crosshairs"></i>
        <span>{{planLayout.sharedTarget.prefix}}</span>
        {{#if planLayout.sharedTarget.intelKey}}
          <button type="button" class="combater-shared-target-name is-intel-target" data-open-target-intel="{{planLayout.sharedTarget.intelKey}}" data-tooltip="{{planLayout.sharedTarget.intelTooltip}}">{{planLayout.sharedTarget.label}}</button>
        {{else}}
          <strong class="combater-shared-target-name">{{planLayout.sharedTarget.label}}</strong>
        {{/if}}
      </div>
    {{/if}}
    <div class="combater-sequence" data-drag-list aria-label="{{localize "PF2E_COMBATER.Panel.PlannedSequenceAria"}}">
      {{#each headerSteps}}
        {{#if isGroup}}
          <div class="combater-step-group" data-drag-row="{{instanceId}}"{{#if pipSlots}} data-step-pips="{{pipSlots}}"{{/if}}>
            <div class="combater-step-group-header">
              <button type="button" class="combater-chip combater-step-group-open" data-open-draft-group="{{instanceId}}" data-tooltip="{{groupLabel}}">
                {{#if stepNumber}}<span class="combater-step-number" aria-hidden="true"><span>{{stepNumber}}</span></span>{{/if}}
                <span class="combater-chip-cost" aria-label="{{costLabel}}">
                  <img class="combater-cost-glyph" src="{{actionGlyphIcon}}" alt="{{costLabel}}">
                </span>
                <span class="combater-step-main">
                  <span class="combater-step-group-name">{{groupLabel}}</span>
                  {{#if hasTraitChips}}
                  <span class="combater-step-details">
                    {{#each traitChips}}
                      <span class="combater-detail-chip {{class}}"{{#if tooltipHtml}} data-tooltip-html="{{tooltipHtml}}"{{else}} data-tooltip="{{tooltip}}"{{/if}}>{{label}}</span>
                    {{/each}}
                    {{#if traitOverflow}}<span class="combater-detail-chip is-trait-overflow" data-tooltip="{{traitOverflow.tooltip}}">{{traitOverflow.label}}</span>{{/if}}
                  </span>
                  {{/if}}
                </span>
              </button>
              <span class="combater-step-tools">
                {{#if canDragStep}}
                  <span class="combater-chip-tool combater-step-drag" data-drag-draft-step="{{instanceId}}" draggable="true" data-tooltip="{{localize "PF2E_COMBATER.Panel.DragToReorder"}}" aria-label="{{localize "PF2E_COMBATER.Panel.DragToReorderAria" name=groupLabel}}">
                    <i class="fa-solid fa-grip-vertical"></i>
                  </span>
                {{/if}}
              </span>
            </div>
            <div class="combater-step-group-children">
              {{#each children}}
                {{> draftStepChip}}
              {{/each}}
            </div>
          </div>
        {{else}}
          {{#if instanceId}}
            {{> draftStepChip}}
          {{else}}
            <button type="button" class="combater-chip {{costClass}}" data-execute-step="{{index}}" data-preview-plan="auto" data-preview-step="{{index}}" data-tooltip="{{name}}{{#if targetLabel}} - {{targetLabel}}{{/if}}{{#if mapLabel}} - {{mapLabel}}{{/if}}: {{reason}}">
              <span class="combater-chip-cost" aria-label="{{costLabel}}">
                <img class="combater-cost-glyph" src="{{actionGlyphIcon}}" alt="{{costLabel}}">
              </span>
              <span class="combater-chip-text">
                <span class="combater-chip-titlerow">
                  {{#if img}}<img class="combater-chip-img" src="{{img}}" alt="">{{/if}}
                  <span class="combater-chip-name">{{name}}</span>
                </span>
                {{#if targetLabel}}<span class="combater-chip-target{{#if canOpenTargetIntel}} is-intel-target{{/if}}"{{#if canOpenTargetIntel}} data-open-target-intel="{{targetIntelKey}}" data-tooltip="{{targetIntelTooltip}}"{{/if}}>{{targetLabel}}</span>{{/if}}
                {{#if mapLabel}}<span class="combater-chip-target">{{mapLabel}}</span>{{/if}}
                {{#if isRanged}}<span class="combater-detail-chip is-range"><i class="fa-solid fa-crosshairs"></i> {{rangeLabel}}</span>{{/if}}
                {{> minionPlanDetails}}
              </span>
            </button>
          {{/if}}
        {{/if}}
      {{else}}
        <span class="combater-empty-chip">{{localize "PF2E_COMBATER.Panel.NoSelectedActions"}}</span>
      {{/each}}
    </div>
    {{#if headerSummary}}
    <p class="combater-reason">{{headerSummary}}</p>
    {{/if}}
  </div>
  {{/inline}}

  <header class="combater-compact">
    <div class="combater-top-row">
    {{#if actor}}
      <div class="combater-identity">
        <img class="combater-portrait" src="{{actor.img}}" alt="{{actor.name}}">
        <div class="combater-headline">
          <div class="combater-name-row">
            <h2>{{actor.name}}</h2>
          </div>
          <div class="combater-meta-row">
            <div class="combater-header-badges">
              {{#if builder}}
                {{#unless actionTracker.visible}}
                  <span class="combater-action-count" data-tooltip="{{builder.totalSummary}}. {{builder.reactionSummary}}.">{{builder.poolSummary}}</span>
                {{/unless}}
                {{#if builder.isPlayerPlan}}
                  <span class="combater-player-plan-badge" data-tooltip="{{builder.playerPlanTooltip}}">
                    <i class="fa-solid fa-user-group"></i>
                    <span>{{builder.playerPlanLabel}}</span>
                  </span>
                {{/if}}
              {{/if}}
            </div>
          </div>
        </div>
      </div>
    {{else}}
      <div class="combater-identity">
        <div class="combater-portrait placeholder" aria-hidden="true"></div>
        <div class="combater-headline">
          <div class="combater-name-row">
            <h2>{{localize "PF2E_COMBATER.Panel.NoActiveCombatant"}}</h2>
          </div>
          <p class="combater-reason">{{localize "PF2E_COMBATER.Panel.NoActiveCombatantHint"}}</p>
        </div>
      </div>
    {{/if}}
    {{#if turnControls.controlsCurrent}}
      <div class="combater-turn-controls is-header">
        <div class="combater-turn-split">
          <button type="button" class="combater-turn-button is-end" data-turn-control="end" data-tooltip="{{turnControls.endHint}}" {{#unless turnControls.canEnd}}disabled{{/unless}}><i class="fa-solid fa-forward-step"></i> {{turnControls.endLabel}}</button>
          <button type="button" class="combater-turn-button is-more" data-turn-menu-toggle aria-haspopup="true" aria-expanded="false" aria-label="{{turnControls.moreLabel}}" data-tooltip="{{turnControls.moreLabel}}" {{#unless turnControls.canOpenMenu}}disabled{{/unless}}><i class="fa-solid fa-chevron-down"></i></button>
          <div class="combater-turn-menu" data-turn-menu popover="auto" role="group" aria-label="{{turnControls.moreLabel}}">
            <button type="button" data-turn-control="delay" {{#unless turnControls.canDelay}}disabled{{/unless}}><i class="fa-solid fa-hourglass-half"></i><span><strong>{{turnControls.delayLabel}}</strong><small>{{turnControls.delayDetail}}</small></span></button>
            <button type="button" data-turn-control="ready" {{#unless turnControls.canReady}}disabled{{/unless}}><i class="fa-solid fa-bullseye"></i><span><strong>{{turnControls.readyLabel}} <span class="action-glyph">2</span></strong><small>{{turnControls.readyDetail}}</small></span></button>
          </div>
        </div>
      </div>
    {{/if}}
    </div>

    {{#if turnControls.readied}}
      <div class="combater-readied" data-tooltip="{{turnControls.readied.hint}}">
        <i class="fa-solid fa-bullseye"></i>
        <span class="combater-readied-text"><strong>{{turnControls.readied.title}}</strong></span>
        {{#if turnControls.readied.canUse}}
          <button type="button" class="combater-turn-button is-ready-use" data-turn-control="ready-use" data-readied-id="{{turnControls.readied.id}}"><i class="fa-solid fa-bolt"></i> {{turnControls.readied.useLabel}}</button>
          <button type="button" class="combater-turn-button is-ready-clear" data-turn-control="ready-clear" data-readied-id="{{turnControls.readied.id}}" aria-label="{{turnControls.readied.clearLabel}}" data-tooltip="{{turnControls.readied.clearLabel}}"><i class="fa-solid fa-xmark"></i></button>
        {{/if}}
      </div>
    {{/if}}
    {{#if (or turnControls.waitingLabel turnControls.delayed.length turnControls.reactionUsedLabel)}}
      <div class="combater-turn-controls">
        {{#if turnControls.reactionUsedLabel}}<span class="combater-reaction-used" data-tooltip="{{turnControls.reactionUsedHint}}"><i class="fa-solid fa-rotate-left"></i> {{turnControls.reactionUsedLabel}}</span>{{/if}}
        {{#if turnControls.waitingLabel}}<span class="combater-turn-waiting" data-tooltip="{{turnControls.waitingHint}}"><i class="fa-solid fa-hourglass-half"></i> {{turnControls.waitingLabel}}</span>{{/if}}
        {{#each turnControls.delayed}}
          <button type="button" class="combater-turn-button is-return" data-turn-control="return" data-delayed-id="{{id}}" data-tooltip="{{tooltip}}"><i class="fa-solid fa-arrow-right-to-bracket"></i> {{name}} · {{../turnControls.bringInLabel}}</button>
        {{/each}}
      </div>
    {{/if}}
    {{#if upcomingTurns.visible}}
      <aside class="combater-upcoming" aria-label="{{upcomingTurns.label}}" aria-live="polite" aria-atomic="true">
        <ol class="combater-upcoming-track" data-combat-id="{{upcomingTurns.combatId}}" data-turn-key="{{upcomingTurns.turnKey}}">
          {{#each upcomingTurns.entries}}
            <li><button type="button" class="combater-upcoming-turn {{#if next}}is-next{{else}}is-following{{/if}}" data-upcoming-combatant="{{id}}" data-upcoming-round="{{round}}" data-tooltip="{{tooltip}}" aria-label="{{tooltip}}">
              <span class="combater-upcoming-label">{{label}}</span>
              <img class="combater-upcoming-portrait" src="{{img}}" alt="">
              <span class="combater-upcoming-name">{{name}}</span>
              {{#if nextRound}}<span class="combater-upcoming-round">{{roundLabel}}</span>{{/if}}
            </button></li>
          {{/each}}
        </ol>
      </aside>
    {{/if}}
    <div class="combater-actions combater-planning">
      {{#if (or tacticPersonality.visible intelLedger.visible resourceHorizon.visible turnIntent.visible loadoutAdvisor.visible)}}
      <div class="combater-setup-row">
        <button type="button" class="combater-profile-toggle" data-profile-menu-toggle aria-haspopup="true" aria-expanded="false" aria-label="{{profileMenu.ariaLabel}}" data-tooltip="{{profileMenu.ariaLabel}}">
          <i class="fa-solid fa-sliders"></i><span>{{profileMenu.label}}</span><i class="fa-solid fa-chevron-down combater-profile-caret"></i>
        </button>
        <div class="combater-profile-menu" data-profile-menu popover="auto" role="group" aria-label="{{localize "PF2E_COMBATER.Panel.PlanSetup"}}">
        {{#if tacticPersonality.visible}}
          <button type="button" class="combater-header-tactic {{#if tacticPersonality.isOverride}}is-override{{/if}}" data-configure-tactic data-tooltip="{{tacticPersonality.tooltip}}" aria-label="{{localize "PF2E_COMBATER.Panel.TacticAria"}}">
            <i class="fa-solid fa-chess-knight"></i>
            <span class="combater-header-tactic-label">{{tacticPersonality.label}}</span>
          </button>
        {{/if}}
        {{#if intelLedger.visible}}
          <button type="button" class="combater-header-intel" data-configure-intel data-tooltip="{{intelLedger.tooltip}}" aria-label="{{localize "PF2E_COMBATER.Panel.IntelAria"}}">
            <i class="fa-solid fa-brain"></i>
            <span>{{intelLedger.label}}</span>
          </button>
        {{/if}}
        {{#if resourceHorizon.visible}}
          <button type="button" class="combater-header-resource {{#if resourceHorizon.isConserve}}is-conserve{{/if}} {{#if resourceHorizon.isBurst}}is-burst{{/if}}" data-cycle-resource-horizon data-tooltip="{{resourceHorizon.tooltip}}" aria-label="{{resourceHorizon.ariaLabel}}">
            <i class="fa-solid {{resourceHorizon.icon}}"></i>
            <span>{{resourceHorizon.label}}</span>
          </button>
        {{/if}}
        {{#if turnIntent.visible}}
          <button type="button" class="combater-header-intent {{#if turnIntent.active}}is-active{{/if}}" data-configure-turn-intent data-tooltip="{{turnIntent.tooltip}}" aria-label="{{turnIntent.tooltip}}" aria-pressed="{{#if turnIntent.active}}true{{else}}false{{/if}}">
            <i class="fa-solid fa-bullseye"></i>
            <span>{{turnIntent.label}}</span>
          </button>
        {{/if}}
        {{#if loadoutAdvisor.visible}}
          <button type="button" class="combater-header-loadout {{#if loadoutAdvisor.active}}is-active{{/if}}" data-open-loadout-advisor data-tooltip="{{loadoutAdvisor.tooltip}}" aria-label="{{loadoutAdvisor.tooltip}}">
            <i class="fa-solid fa-shield-halved"></i>
            <span>{{loadoutAdvisor.label}}</span>
          </button>
        {{/if}}
        </div>
      </div>
      {{/if}}
      <div class="combater-actions-row combater-plan-toolbar" role="group" aria-label="{{localize "PF2E_COMBATER.Panel.PlanToolbar"}}">
        {{#if builder}}
          {{#unless builder.readonly}}
            {{#if showAutoFill}}
            <button type="button" class="combater-header-autofill" data-auto-fill data-tooltip="{{localize "PF2E_COMBATER.Panel.AutoFillTooltip"}}" aria-label="{{localize "PF2E_COMBATER.Panel.AutoFillAria"}}">
              <i class="fa-solid fa-wand-magic-sparkles"></i>
              <span>{{localize "PF2E_COMBATER.Panel.AutoFill"}}</span>
            </button>
            {{#if autoFillCycle.canCycle}}
            <span class="combater-header-alternatives" role="group" aria-label="{{autoFillCycle.ariaLabel}}" data-tooltip="{{autoFillCycle.tooltip}}">
              <button type="button" data-cycle-auto-fill-previous aria-label="{{autoFillCycle.previousLabel}}"><i class="fa-solid fa-chevron-left"></i></button>
              <span class="combater-alt-position">{{autoFillCycle.planWord}} <strong>{{autoFillCycle.position}}</strong> {{autoFillCycle.ofLabel}}</span>
              <button type="button" data-cycle-auto-fill aria-label="{{autoFillCycle.nextLabel}}"><i class="fa-solid fa-chevron-right"></i></button>
            </span>
            {{/if}}
            {{/if}}
          {{/unless}}
        {{/if}}
        <button type="button" class="combater-header-browse {{#if browserOpen}}is-active{{/if}}" data-action="toggle-browser" data-tooltip="{{#if browserOpen}}{{localize "PF2E_COMBATER.Panel.BrowseClose"}}{{else}}{{localize "PF2E_COMBATER.Panel.BrowseOpen"}}{{/if}}" aria-label="{{localize "PF2E_COMBATER.Panel.BrowseAria"}}" aria-pressed="{{#if browserOpen}}true{{else}}false{{/if}}">
          <i class="fa-solid fa-layer-group"></i>
          <span>{{localize "PF2E_COMBATER.Panel.Browse"}}</span>
        </button>
        <div class="combater-utilities">
          <button type="button" class="icon-button combater-utilities-toggle" data-panel-utilities aria-expanded="false" data-tooltip="{{localize "PF2E_COMBATER.Panel.WindowOptions"}}" aria-label="{{localize "PF2E_COMBATER.Panel.WindowOptions"}}"><i class="fa-solid fa-ellipsis"></i></button>
          <div class="combater-utilities-menu" data-panel-utilities-menu popover="auto" role="group" aria-label="{{localize "PF2E_COMBATER.Panel.WindowOptions"}}">
            <button type="button" data-action="refresh"><i class="fa-solid fa-arrows-rotate"></i><span>{{localize "PF2E_COMBATER.Panel.Refresh"}}</span></button>
            <button type="button" data-action="toggle-compact" aria-pressed="{{#if expanded}}false{{else}}true{{/if}}"><i class="fa-solid {{#if expanded}}fa-compress{{else}}fa-expand{{/if}}"></i><span>{{#if expanded}}{{localize "PF2E_COMBATER.Panel.CompactCollapse"}}{{else}}{{localize "PF2E_COMBATER.Panel.CompactExpand"}}{{/if}}</span></button>
          </div>
        </div>
      </div>
    </div>
    {{#if (or actionTracker.visible effectClock.visible)}}
    <div class="combater-turn-status">
    {{#if actionTracker.visible}}
      <section class="combater-action-tracker {{#if actionTracker.forecast}}is-forecast{{else}}is-current{{/if}}" aria-label="{{actionTracker.label}}" data-tooltip="{{actionTracker.hint}}" aria-live="polite">
        <span class="combater-tracker-pips" aria-hidden="true">{{#each actionTracker.pips}}<span class="combater-pip {{#if quickened}}is-quickened{{/if}} {{#if spent}}is-spent{{/if}}" data-pip="{{slot}}"><span class="action-glyph">1</span>{{#if owner}}<span class="combater-pip-owner">{{owner}}</span>{{/if}}</span>{{/each}}</span>
        <span class="combater-tracker-text">
          <strong><span class="combater-tracker-label">{{actionTracker.label}}</span> {{actionTracker.countLabel}}</strong>
          {{#if actionTracker.plannedLabel}}<small class="{{#if actionTracker.overPlanned}}is-over{{/if}}">{{actionTracker.plannedLabel}}</small>{{/if}}
          {{#if actionTracker.conditions}}<small>{{actionTracker.conditions}}</small>{{/if}}
        </span>
        {{#if actionTracker.quickened}}
          {{#if actionTracker.quickenedPending}}
            <button type="button" class="combater-tracker-quickened is-pending {{#if actionTracker.quickenedNeedsConfiguration}}needs-configuration{{/if}}" data-quickened-allowance data-tooltip="{{actionTracker.quickenedPendingHint}} {{actionTracker.quickenedHint}}" {{#unless actionTracker.canConfigureQuickened}}disabled{{/unless}}>{{actionTracker.quickenedPendingLabel}}{{#if actionTracker.quickenedNeedsConfiguration}} · {{actionTracker.quickenedSetupLabel}}{{/if}}</button>
          {{else}}
            {{#if actionTracker.quickenedNeedsConfiguration}}
              <button type="button" class="combater-tracker-quickened needs-configuration" data-quickened-allowance data-tooltip="{{actionTracker.quickenedHint}}" {{#unless actionTracker.canConfigureQuickened}}disabled{{/unless}}>{{actionTracker.quickenedLabel}} · {{actionTracker.quickenedSetupLabel}}</button>
            {{/if}}
          {{/if}}
        {{/if}}
        {{#if actionTracker.editable}}
          <button type="button" class="combater-tracker-adjust-toggle" data-tracker-adjust-toggle aria-haspopup="true" aria-expanded="false" aria-label="{{actionTracker.adjustLabel}}" data-tooltip="{{actionTracker.adjustLabel}}"><i class="fa-solid fa-sliders"></i></button>
          <div class="combater-tracker-adjust-menu" data-tracker-adjust-menu popover="auto" role="group" aria-label="{{actionTracker.adjustLabel}}">
            <div class="combater-tracker-stepper">
              <span>{{actionTracker.label}}</span>
              <span class="combater-tracker-stepper-controls">
                <button type="button" data-tracker-adjust="1" data-tracker-pool="normal" aria-label="{{actionTracker.spendLabel}}" {{#unless actionTracker.canSpend}}disabled{{/unless}}>−</button>
                <output>{{actionTracker.normal}}</output>
                <button type="button" data-tracker-adjust="-1" data-tracker-pool="normal" aria-label="{{actionTracker.refundLabel}}" {{#unless actionTracker.canRefund}}disabled{{/unless}}>+</button>
              </span>
            </div>
            {{#if actionTracker.quickened}}{{#unless actionTracker.quickenedPending}}
            <div class="combater-tracker-stepper">
              <button type="button" class="combater-tracker-quickened" data-quickened-allowance data-tooltip="{{actionTracker.quickenedHint}}" {{#unless actionTracker.canConfigureQuickened}}disabled{{/unless}}>{{actionTracker.quickenedLabel}}</button>
              <span class="combater-tracker-stepper-controls">
                <button type="button" data-tracker-adjust="1" data-tracker-pool="quickened" aria-label="{{actionTracker.spendLabel}} ({{actionTracker.quickenedLabel}})" {{#unless actionTracker.canSpendQuickened}}disabled{{/unless}}>−</button>
                <output>{{actionTracker.quickenedLeft}}</output>
                <button type="button" data-tracker-adjust="-1" data-tracker-pool="quickened" aria-label="{{actionTracker.refundLabel}} ({{actionTracker.quickenedLabel}})" {{#unless actionTracker.canRefundQuickened}}disabled{{/unless}}>+</button>
              </span>
            </div>
            {{/unless}}{{/if}}
          </div>
        {{/if}}
      </section>
    {{/if}}
        {{#if effectClock.visible}}
          <button type="button" class="combater-header-clock {{#if effectClock.active}}is-active{{/if}} {{#if effectClock.urgent}}is-urgent{{/if}}" data-open-effect-clock data-tooltip="{{effectClock.tooltip}}" aria-label="{{effectClock.tooltip}}">
            <i class="fa-solid fa-hourglass-half"></i>
            <span>{{effectClock.label}}</span>
          </button>
        {{/if}}
    </div>
    {{/if}}
      {{#if builder}}
        {{#if builder.execution.hasStatus}}
          <div class="combater-execution-controls">
            {{#if builder.execution.canReset}}
              <button type="button" class="combater-chip-tool combater-header-reset" data-reset-execution data-tooltip="{{localize "PF2E_COMBATER.Panel.ResetTooltip"}}" aria-label="{{localize "PF2E_COMBATER.Panel.ResetAria"}}">
                <i class="fa-solid fa-rotate-left"></i>
                <span>{{localize "PF2E_COMBATER.Panel.Reset"}}</span>
              </button>
            {{/if}}
            {{#if builder.execution.progressLabel}}
              <span class="combater-exec-progress" data-tooltip="{{localize "PF2E_COMBATER.Panel.ExecutedSteps"}}">{{builder.execution.progressLabel}}</span>
            {{/if}}
          </div>
        {{/if}}
      {{/if}}
  </header>

  {{#if builder}}
    <div class="combater-plan">
      {{#if actor}}{{> draftSequence}}{{/if}}

      {{#if builder.sustainedSpells.hasEntries}}
        <section class="combater-sustained-panel">
          <article class="combater-alt combater-builder-card combater-sustained-spells">
            <div class="combater-alt-head">
              <span class="combater-alt-title">
                <strong>{{localize "PF2E_COMBATER.Panel.SustainedSpells"}}</strong>
              </span>
            </div>
            <div class="combater-alt-details">
              {{#each builder.sustainedSpells.entries}}
                <div class="combater-alt-step combater-sustained-row {{statusClass}}">
                  <span class="combater-step-cost cost-1" data-tooltip="{{localize "PF2E_COMBATER.Panel.OneAction"}}">
                    <span>◆</span>
                  </span>
                  <div class="combater-alt-step-body">
                    <h4>
                      {{#if spellUuid}}
                        <button type="button" class="combater-sustained-name" data-open-sustained-spell="{{spellUuid}}" data-tooltip="{{localize "PF2E_COMBATER.Panel.OpenDetails"}}" aria-label="{{localize "PF2E_COMBATER.Panel.ActionDetailsAria"}}: {{name}}">
                          {{name}}
                        </button>
                      {{else}}
                        <span class="combater-sustained-name">{{name}}</span>
                      {{/if}}
                    </h4>
                    <span class="combater-target" data-tooltip="{{statusLabel}}{{#if detailLabel}} - {{detailLabel}}{{/if}}">
                      {{statusLabel}}{{#if detailLabel}} - {{detailLabel}}{{/if}}
                    </span>
                  </div>
                  {{#if canAdd}}
                    <button type="button" class="combater-run combater-add-action" data-add-sustain-spell="{{id}}" data-tooltip="{{localize "PF2E_COMBATER.Panel.AddSustain"}}" aria-label="{{localize "PF2E_COMBATER.Panel.SustainAria" name=name}}">
                      <i class="fa-solid fa-plus"></i>
                    </button>
                  {{/if}}
                </div>
              {{/each}}
            </div>
          </article>
        </section>
      {{/if}}

      {{#if builder.uncounted.hasEntries}}
        <section class="combater-uncounted-panel">
          <article class="combater-alt combater-builder-card combater-uncounted">
            <div class="combater-alt-head">
              <span class="combater-alt-title"><strong>{{localize "PF2E_COMBATER.Panel.UncountedActions"}}</strong></span>
            </div>
            <div class="combater-alt-details" data-drag-list>
              {{#each builder.uncounted.entries}}
                <div class="combater-alt-step combater-uncounted-row status-{{executionStatus}} {{#if isCurrentExecution}}is-current{{/if}}" data-preview-draft-step="{{instanceId}}" data-drag-row="{{instanceId}}">
                  <span class="combater-step-cost {{costClass}}" data-tooltip="{{costLabel}}">
                    <img class="combater-cost-glyph" src="{{actionGlyphIcon}}" alt="{{costLabel}}">
                  </span>
                  <div class="combater-alt-step-body">
                    <h4>
                      <button type="button" class="combater-alt-promote" data-open-draft-step="{{instanceId}}" data-tooltip="{{name}}: {{reason}}">
                        {{#if img}}<img class="combater-action-img" src="{{img}}" alt="">{{/if}}
                        <span>{{name}}</span>
                      </button>
                      {{#if isExecutionDone}}<span class="combater-exec-badge is-done"><i class="fa-solid fa-check"></i> {{localize "PF2E_COMBATER.Panel.Done"}}</span>{{/if}}
                      {{#if isExecutionFailed}}<span class="combater-exec-badge is-failed" data-tooltip="{{executionTooltip}}"><i class="fa-solid fa-triangle-exclamation"></i> {{localize "PF2E_COMBATER.Panel.Failed"}}</span>{{/if}}
                    </h4>
                    {{#if hasStepDetails}}
                      {{#if awaitingGm}}
                      <span class="combater-target{{#if awaitingGm}} is-awaiting{{/if}}">
                        {{#if awaitingGm}}<i class="fa-solid fa-hourglass-half fa-spin"></i> {{awaitingGmLabel}}{{else}}{{#if targetLabel}}{{targetLabel}}{{/if}}{{#if areaLabel}} {{areaLabel}}{{/if}}{{#if warning}} - {{warning}}{{/if}}{{/if}}
                      </span>
                      {{else}}
                      {{#if targetLabel}}<span class="combater-target{{#if canOpenTargetIntel}} is-intel-target{{/if}}"{{#if canOpenTargetIntel}} data-open-target-intel="{{targetIntelKey}}" data-tooltip="{{targetIntelTooltip}}"{{/if}}>{{targetLabel}}</span>{{#if areaLabel}}<span class="combater-target">{{areaLabel}}</span>{{/if}}{{#if warning}}<span class="combater-target is-warning">{{warning}}</span>{{/if}}{{else}}{{#if areaLabel}}<span class="combater-target">{{areaLabel}}{{#if warning}} - {{warning}}{{/if}}</span>{{else}}{{#if warning}}<span class="combater-target">{{warning}}</span>{{/if}}{{/if}}{{/if}}
                      {{/if}}
                      {{> minionPlanDetails}}
                    {{/if}}
                  </div>
                  <div class="combater-uncounted-tools">
                    {{#if canChooseSummon}}
                      <button type="button" class="combater-chip-tool" data-choose-summon="{{instanceId}}" data-tooltip="{{localize "PF2E_COMBATER.Summon.Choose"}}" aria-label="{{localize "PF2E_COMBATER.Summon.Choose"}}"><i class="fa-solid fa-paw"></i></button>
                    {{/if}}
                    {{#if summonLabel}}<span class="combater-target">{{summonLabel}}</span>{{/if}}
                    {{#if requiresTarget}}
                      <button type="button" class="combater-chip-tool" data-choose-target="{{instanceId}}" data-tooltip="{{targetToolTip}}" aria-label="{{localize "PF2E_COMBATER.Panel.ChooseTargetAria" name=name}}"><i class="fa-solid fa-crosshairs"></i></button>
                    {{/if}}
                    {{#if requiresDestination}}
                      <button type="button" class="combater-chip-tool" data-choose-destination="{{instanceId}}" data-tooltip="{{localize "PF2E_COMBATER.Panel.ChooseDestination"}}" aria-label="{{localize "PF2E_COMBATER.Panel.ChooseDestinationAria" name=name}}"><i class="fa-solid fa-location-dot"></i></button>
                    {{/if}}
                    {{#if canChooseArea}}
                      <button type="button" class="combater-chip-tool" data-choose-area="{{instanceId}}" data-tooltip="{{localize "PF2E_COMBATER.Panel.PlaceTemplate"}}" aria-label="{{localize "PF2E_COMBATER.Panel.PlaceTemplateAria" name=name}}"><i class="fa-solid fa-draw-polygon"></i></button>
                    {{/if}}
                    {{#if canChooseRecommendedArea}}
                      <button type="button" class="combater-chip-tool combater-area-placement" data-choose-recommended-area="{{instanceId}}" data-tooltip="{{areaPlacementToolTip}}" aria-label="{{areaPlacementToolTip}}"><i class="fa-solid fa-bullseye"></i><span class="combater-area-placement-value">{{areaPlacementToolLabel}}</span></button>
                    {{/if}}
                    {{#if hasAreaMarker}}
                      <button type="button" class="combater-chip-tool" data-remove-area="{{instanceId}}" data-tooltip="{{localize "PF2E_COMBATER.Panel.RemoveTemplate"}}" aria-label="{{localize "PF2E_COMBATER.Panel.RemoveTemplate"}}"><i class="fa-solid fa-eraser"></i></button>
                    {{/if}}
                    {{#if canCycleMap}}
                      <button type="button" class="combater-chip-tool combater-map-cycle {{#if mapPinned}}is-pinned{{/if}}" data-cycle-map="{{instanceId}}" data-tooltip="{{mapToolTip}}" aria-label="{{mapToolTip}}"><i class="fa-solid fa-burst"></i><span class="combater-map-value">{{mapToolLabel}}</span></button>
                    {{/if}}
                    {{#if canCycleMovement}}
                      <button type="button" class="combater-chip-tool combater-movement-cycle" data-cycle-movement="{{instanceId}}" data-tooltip="{{movementToolTip}}" aria-label="{{movementToolTip}}"><i class="fa-solid fa-shoe-prints"></i><span class="combater-movement-value">{{movementToolLabel}}</span></button>
                    {{/if}}
                    {{#if canCycleRoute}}
                      <button type="button" class="combater-chip-tool combater-route-cycle" data-cycle-route="{{instanceId}}" data-tooltip="{{routeModeToolTip}}" aria-label="{{routeModeToolTip}}"><i class="fa-solid fa-route"></i><span class="combater-route-value">{{routeModeLabel}}</span></button>
                    {{/if}}
                    {{#if canCycleDestination}}
                      <button type="button" class="combater-chip-tool combater-destination-cycle" data-cycle-destination="{{instanceId}}" data-tooltip="{{movementAlternativeToolTip}}" aria-label="{{movementAlternativeToolTip}}"><i class="fa-solid fa-location-crosshairs"></i><span class="combater-destination-value">{{movementAlternativeToolLabel}}</span></button>
                    {{/if}}
                    {{#if canDragStep}}
                      <span class="combater-chip-tool combater-step-drag" data-drag-draft-step="{{instanceId}}" draggable="true" data-tooltip="{{localize "PF2E_COMBATER.Panel.DragToReorder"}}" aria-label="{{localize "PF2E_COMBATER.Panel.DragToReorderAria" name=name}}"><i class="fa-solid fa-grip-vertical"></i></span>
                    {{/if}}
                    {{#if awaitingGm}}
                      <span class="combater-chip-tool combater-step-waiting" data-tooltip="{{awaitingGmLabel}}" aria-label="{{awaitingGmLabel}}"><i class="fa-solid fa-hourglass-half fa-spin"></i></span>
                    {{else}}
                    {{#if canShowExecuteStep}}
                      <button type="button" class="combater-chip-tool combater-step-run is-execute {{#if executionBlocked}}is-disabled{{/if}}" data-execute-draft-step="{{instanceId}}" data-tooltip="{{executeTooltip}}" aria-label="{{executeTooltip}}" {{#if executionBlocked}}disabled{{/if}}><i class="fa-solid fa-play"></i></button>
                    {{/if}}
                    {{/if}}
                    {{#if canRevertStep}}
                      <button type="button" class="combater-chip-tool combater-step-run is-revert" data-revert-step="{{instanceId}}" data-tooltip="{{localize "PF2E_COMBATER.Panel.Revert"}}" aria-label="{{localize "PF2E_COMBATER.Panel.RevertAria" name=name}}"><i class="fa-solid fa-rotate-left"></i></button>
                    {{/if}}
                    {{#unless readonly}}
                      <button type="button" class="combater-chip-tool danger" data-remove-draft-step="{{instanceId}}" data-tooltip="{{localize "PF2E_COMBATER.Panel.Remove"}}" aria-label="{{localize "PF2E_COMBATER.Panel.RemoveAria" name=name}}"><i class="fa-solid fa-xmark"></i></button>
                    {{/unless}}
                  </div>
                </div>
              {{/each}}
            </div>
          </article>
        </section>
      {{/if}}
    </div>
  {{/if}}
  {{#if (or planLayout.footer.visible planPreference.visible)}}
  <footer class="combater-run-footer">
    {{#if planLayout.footer.visible}}
      <div class="combater-run-row">
        <button type="button" class="combater-run-next" data-run-next="{{planLayout.footer.instanceId}}" data-tooltip="{{planLayout.footer.tooltip}}" {{#if planLayout.footer.blocked}}disabled{{/if}}>
          <i class="fa-solid fa-play"></i><span>{{planLayout.footer.label}}</span>
        </button>
        {{#if planLayout.footer.canRunAll}}
          <button type="button" class="combater-run-all" data-run-all data-tooltip="{{planLayout.footer.runAllTooltip}}"><i class="fa-solid fa-forward"></i> {{planLayout.footer.runAllLabel}}</button>
        {{/if}}
      </div>
    {{/if}}
    {{#if planPreference.visible}}
    <div class="combater-plan-preference" data-tooltip="{{planPreference.tooltip}}">
      <span class="combater-plan-preference-label">{{planPreference.label}}</span>
      <button type="button" class="combater-chip-tool combater-plan-preference-button is-positive {{#if planPreference.positive}}is-active{{/if}}" data-plan-preference="1" data-tooltip="{{planPreference.positiveTitle}}" aria-label="{{planPreference.positiveTitle}}" aria-pressed="{{#if planPreference.positive}}true{{else}}false{{/if}}">
        <i class="{{#if planPreference.positive}}fa-solid{{else}}fa-regular{{/if}} fa-thumbs-up"></i>
      </button>
      <button type="button" class="combater-chip-tool combater-plan-preference-button is-negative {{#if planPreference.negative}}is-active{{/if}}" data-plan-preference="-1" data-tooltip="{{planPreference.negativeTitle}}" aria-label="{{planPreference.negativeTitle}}" aria-pressed="{{#if planPreference.negative}}true{{else}}false{{/if}}">
        <i class="{{#if planPreference.negative}}fa-solid{{else}}fa-regular{{/if}} fa-thumbs-down"></i>
      </button>
    </div>
    {{/if}}
  </footer>
  {{/if}}
</div>
