<div class="combater-shell {{#if expanded}}is-expanded{{else}}is-compact{{/if}}">
  <header class="combater-compact">
    {{#if actor}}
      <img class="combater-portrait" src="{{actor.img}}" alt="{{actor.name}}">
      <div class="combater-headline">
        <div class="combater-name-row">
          <h2>{{actor.name}}</h2>
          <span class="combater-confidence confidence-{{plan.confidenceClass}}">{{headerMode}}</span>
        </div>
        <div class="combater-sequence" aria-label="{{headerMode}} action sequence">
          {{#each headerSteps}}
            {{#if instanceId}}
              <button type="button" class="combater-chip {{costClass}}" data-open-draft-step="{{instanceId}}" data-preview-draft-step="{{instanceId}}" title="{{name}}{{#if targetLabel}} - {{targetLabel}}{{/if}}{{#if warning}} - {{warning}}{{/if}}: {{reason}}">
                <span class="combater-chip-cost" aria-label="{{costLabel}}">
                  {{#each diamonds}}<span>{{this}}</span>{{/each}}
                </span>
                <span class="combater-chip-text">
                  <span class="combater-chip-name">{{name}}{{#if isRanged}} <i class="fa-solid fa-crosshairs combater-chip-ranged" title="{{rangeLabel}}"></i>{{/if}}</span>
                  {{#if targetLabel}}<span class="combater-chip-target">{{targetLabel}}</span>{{/if}}
                  {{#if warning}}<span class="combater-chip-target">{{warning}}</span>{{/if}}
                </span>
              </button>
            {{else}}
              <button type="button" class="combater-chip {{costClass}}" data-execute-step="{{index}}" data-preview-plan="auto" data-preview-step="{{index}}" title="{{name}}{{#if targetLabel}} - {{targetLabel}}{{/if}}{{#if mapLabel}} - {{mapLabel}}{{/if}}: {{reason}}">
                <span class="combater-chip-cost" aria-label="{{costLabel}}">
                  {{#each diamonds}}<span>{{this}}</span>{{/each}}
                </span>
                <span class="combater-chip-text">
                  <span class="combater-chip-name">{{name}}{{#if isRanged}} <i class="fa-solid fa-crosshairs combater-chip-ranged" title="{{rangeLabel}}"></i>{{/if}}</span>
                  {{#if targetLabel}}<span class="combater-chip-target">{{targetLabel}}</span>{{/if}}
                  {{#if mapLabel}}<span class="combater-chip-target">{{mapLabel}}</span>{{/if}}
                </span>
              </button>
            {{/if}}
          {{else}}
            <span class="combater-empty-chip">No usable action</span>
          {{/each}}
        </div>
        <p class="combater-reason">{{headerSummary}}</p>
      </div>
    {{else}}
      <div class="combater-portrait placeholder" aria-hidden="true"></div>
      <div class="combater-headline">
        <div class="combater-name-row">
          <h2>No active combatant</h2>
          <span class="combater-confidence confidence-low">Low</span>
        </div>
        <p class="combater-reason">Start combat or select readable active actor.</p>
      </div>
    {{/if}}

    <div class="combater-actions">
      {{#if builder}}
        <button type="button" class="combater-header-autofill" data-auto-fill title="Fill draft from recommended plan" aria-label="Auto-fill draft">
          <i class="fa-solid fa-wand-magic-sparkles"></i>
          <span>Auto-fill</span>
        </button>
      {{/if}}
      <button type="button" class="icon-button" data-action="refresh" title="Refresh" aria-label="Refresh">
        <i class="fa-solid fa-rotate-right"></i>
      </button>
      <button type="button" class="icon-button" data-action="toggle-expanded" title="{{#if expanded}}Collapse{{else}}Expand{{/if}}" aria-label="{{#if expanded}}Collapse{{else}}Expand{{/if}}">
        <i class="fa-solid {{#if expanded}}fa-chevron-up{{else}}fa-chevron-down{{/if}}"></i>
      </button>
    </div>
  </header>

  {{#if expanded}}
    {{#if builder}}
      <nav class="combater-tabs" aria-label="PF2e Combater action costs">
        {{#each builder.tabsList}}
          <button type="button" data-tab="{{id}}" class="{{#if active}}active{{/if}}">{{label}}</button>
        {{/each}}
      </nav>

      <section class="combater-body">
        <div class="combater-plan-list">
          <article class="combater-alt combater-builder-card combater-action-pool">
            <div class="combater-alt-head">
              <span class="combater-alt-title">
                <strong>Action pool</strong>
              </span>
              <span class="combater-confidence confidence-medium">{{builder.poolSummary}}</span>
            </div>
            <p>{{builder.totalSummary}}. {{builder.reactionSummary}}.</p>
          </article>

          <article class="combater-alt combater-builder-card combater-draft">
            <div class="combater-alt-head">
              <span class="combater-alt-title">
                <strong>Draft</strong>
              </span>
              <span class="combater-confidence confidence-{{builder.draft.confidenceClass}}">{{builder.draft.countLabel}}</span>
            </div>
            <div class="combater-alt-details">
              {{#each builder.draft.steps}}
                <div class="combater-alt-step combater-draft-step {{#if warning}}has-warning{{/if}} {{#if stale}}is-disabled{{/if}}" data-preview-draft-step="{{instanceId}}">
                  <span class="combater-step-cost {{costClass}}" title="{{costLabel}}">
                    {{#each diamonds}}<span>{{this}}</span>{{/each}}
                  </span>
                  <div class="combater-alt-step-body">
                    <h4>
                      <button type="button" class="combater-alt-promote" data-open-draft-step="{{instanceId}}" title="Open action details">
                        <span>{{position}}. {{name}}</span>
                      </button>
                    </h4>
                    {{#if targetLabel}}<span class="combater-target">{{targetLabel}}</span>{{/if}}
                    {{#if destinationLabel}}<span class="combater-target">{{destinationLabel}}</span>{{/if}}
                    {{#if warning}}<span class="combater-target">{{warning}}</span>{{/if}}
                    <p>{{reason}}</p>
                  </div>
                  {{#if requiresDestination}}
                    <button type="button" class="combater-run" data-choose-destination="{{instanceId}}" title="Choose destination" aria-label="Choose destination">
                      <i class="fa-solid fa-location-crosshairs"></i>
                    </button>
                  {{/if}}
                  <button type="button" class="combater-run" data-remove-draft-step="{{instanceId}}" title="Remove" aria-label="Remove">
                    <i class="fa-solid fa-trash"></i>
                  </button>
                </div>
              {{else}}
                <p class="combater-empty">Select actions below to build a draft turn.</p>
              {{/each}}
            </div>
            {{#if builder.draft.warnings.length}}
              <p>{{#each builder.draft.warnings}}{{this}}{{#unless @last}} {{/unless}}{{/each}}</p>
            {{/if}}
          </article>

          {{#each builder.tabsList}}
            {{#if active}}
              {{#each sections}}
                <article class="combater-alt combater-builder-card combater-action-section">
                  <div class="combater-alt-head">
                    <span class="combater-alt-title">
                      <strong>{{label}}</strong>
                    </span>
                  </div>
                  <div class="combater-alt-details">
                    {{#each actions}}
                      <div class="combater-alt-step combater-action-row {{#if favorite}}is-favorite{{/if}} {{#if disabled}}is-disabled{{/if}}">
                        <button type="button" class="combater-run combater-favorite {{#if favorite}}is-active{{/if}}" data-favorite-action="{{key}}" title="{{favoriteTitle}}" aria-label="{{favoriteTitle}}">
                          <i class="{{#if favorite}}fa-solid fa-star{{else}}fa-regular fa-star{{/if}}"></i>
                        </button>
                        <span class="combater-step-cost {{costClass}}" title="{{costLabel}}">
                          {{#each diamonds}}<span>{{this}}</span>{{/each}}
                        </span>
                        <div class="combater-alt-step-body">
                          <h4>
                            <button type="button" class="combater-alt-promote" data-open-action="{{key}}" title="Open action details">
                              <span>{{name}}</span>
                            </button>
                          </h4>
                          {{#if targetLabel}}<span class="combater-target">{{targetLabel}}</span>{{/if}}
                          {{#if disabledReason}}<span class="combater-target">{{disabledReason}}</span>{{/if}}
                          <p>{{reason}}</p>
                        </div>
                        <button type="button" class="combater-run combater-add-action" data-add-action="{{key}}" title="{{disabledTitle}}" aria-label="Add {{name}}" {{#if disabled}}disabled{{/if}}>
                          <i class="fa-solid fa-plus"></i>
                        </button>
                      </div>
                    {{else}}
                      <p class="combater-empty">No actions in this section.</p>
                    {{/each}}
                  </div>
                </article>
              {{/each}}
            {{/if}}
          {{/each}}

          {{#if showDebug}}
            <div class="combater-debug">
              <details>
                <summary>GM debug: Candidates ({{debug.candidates.length}})</summary>
                {{#each debug.candidates}}
                  <div class="debug-row">
                    <span>{{name}}</span>
                    <code title="{{profile}}">{{source}}{{#if role}}/{{role}}{{/if}}</code>
                    <span>{{costLabel}}</span>
                    <span>{{#if skillCheckLabel}}{{skillCheckLabel}}{{else}}{{#if targetLabel}}{{targetLabel}}{{else}}{{score}}{{/if}}{{/if}}</span>
                  </div>
                {{/each}}
              </details>
              <details>
                <summary>Rejected ({{debug.rejected.length}})</summary>
                {{#each debug.rejected}}
                  <div class="debug-row">
                    <span>{{action.name}}</span>
                    <code>{{action.source}}</code>
                    <span>{{reason}}</span>
                  </div>
                {{/each}}
              </details>
              <details>
                <summary>Detected ({{debug.detected.length}})</summary>
                {{#each debug.detected}}
                  <div class="debug-row">
                    <span>{{name}}</span>
                    <code title="{{profile}}">{{source}}{{#if role}}/{{role}}{{/if}}</code>
                    <span>{{costLabel}}</span>
                    <span>{{#if available}}available{{else}}blocked{{/if}}</span>
                  </div>
                {{/each}}
              </details>
            </div>
          {{/if}}
        </div>
      </section>
    {{else}}
      <section class="combater-body">
        <p class="combater-empty">No combat context available.</p>
      </section>
    {{/if}}
  {{/if}}
</div>
