<div class="combater-intel-shell {{#if editable}}is-editable{{else}}is-readonly{{/if}}">
  <p class="combater-intel-help">{{help}}</p>

  {{#if hasEntries}}
    <form class="combater-intel-body" data-intel-form>
      <div class="combater-intel-grid">
        {{#each entries}}
          <article class="combater-intel-entry {{#if hasRevealed}}has-revealed{{/if}}" data-intel-entry data-intel-entry-index="{{index}}">
            <header class="combater-intel-target-head">
              {{#if img}}
                <img class="combater-intel-img" src="{{img}}" alt="">
              {{else}}
                <span class="combater-intel-img-placeholder"><i class="fa-solid fa-user-secret"></i></span>
              {{/if}}
              <div class="combater-intel-target-text">
                <h3>{{name}}</h3>
                <span
                  class="combater-intel-progress-label"
                  data-intel-status
                  data-intel-progress-template="{{progressTemplate}}"
                  data-intel-total="{{progressTotal}}"
                >{{progressLabel}}</span>
                <span class="combater-intel-meter" aria-hidden="true"><span data-intel-meter style="width: {{progressPercent}}%"></span></span>
              </div>
              {{#if ../editable}}
                <div class="combater-intel-reveal-switch" role="radiogroup" aria-label="{{revealStyleLabel}}" data-tooltip="{{revealStyleLabel}}">
                  {{#each revealModeOptions}}
                    <label class="combater-intel-reveal-option {{#if checked}}is-selected{{/if}}" data-tooltip="{{hint}}">
                      <input type="radio" name="{{inputName}}" value="{{id}}" data-intel-reveal-mode {{#if checked}}checked{{/if}}>
                      <span>{{shortLabel}}</span>
                    </label>
                  {{/each}}
                </div>
              {{/if}}
            </header>

            {{#if ../editable}}
              <div class="combater-intel-editor">
                <div class="combater-intel-category-list">
                  {{#each categories}}
                    <section class="combater-intel-category {{#if checked}}is-known{{/if}}" data-intel-category="{{id}}">
                      <header class="combater-intel-category-head">
                        <button
                          type="button"
                          class="combater-intel-category-mark"
                          data-intel-reveal-category
                          data-tooltip="{{revealAllLabel}}"
                          aria-label="{{revealAllLabel}}"
                        >
                          <i class="fa-solid {{markIcon}}"></i>
                        </button>
                        <span class="combater-intel-category-text">
                          <strong>{{label}}</strong>
                        </span>
                      </header>
                      <div class="combater-intel-facts" data-intel-false-list>
                        {{#each facts}}
                          <label class="combater-intel-fact {{#if checked}}is-known{{/if}} {{#if isNone}}is-none{{/if}}" data-intel-fact>
                            <input type="checkbox" name="{{inputName}}" value="{{id}}" {{#if checked}}checked{{/if}}>
                            <span class="combater-intel-fact-mark">
                              <i class="fa-solid {{#if checked}}fa-check{{else}}fa-plus{{/if}}"></i>
                            </span>
                            <span data-intel-fact-label data-exact-label="{{exactLabel}}" data-band-label="{{bandLabel}}">{{label}}</span>
                            {{#if extreme}}<i class="fa-solid {{extremeIcon}} combater-intel-extreme is-{{extreme}}" data-tooltip="{{extremeLabel}}" aria-label="{{extremeLabel}}"></i>{{/if}}
                            {{#if uuid}}<button type="button" class="combater-intel-info" data-intel-ability-info="{{uuid}}" data-tooltip="{{infoLabel}}" aria-label="{{infoLabel}}"><i class="fa-solid fa-circle-info"></i></button>{{/if}}
                          </label>
                        {{/each}}
                        {{#each falseInformation}}
                          <span
                            class="combater-intel-false-chip {{#if revealed}}is-revealed{{else}}is-prepared{{/if}}"
                            data-intel-false-record-entry="{{entryIndex}}"
                            data-intel-false-record="{{id}}"
                            data-intel-false-category="{{category}}"
                            data-intel-false-revealed="{{revealed}}"
                            data-intel-false-fact-id="{{factId}}"
                            data-intel-false-fact-label="{{chipFactLabel}}"
                            data-intel-false-amount="{{value}}"
                            {{#if sourceLabel}}data-tooltip="{{sourceLabel}}"{{/if}}
                          >
                            <i class="fa-solid fa-triangle-exclamation" aria-hidden="true"></i>
                            <span data-intel-false-chip-label>{{chipLabel}}</span>
                            {{#if canReveal}}
                              <button type="button" class="combater-intel-toggle-false {{#if revealed}}is-revealed{{/if}}" data-intel-toggle-false aria-label="{{revealLabel}}" data-tooltip="{{revealLabel}}">
                                <i class="fa-solid {{#if revealed}}fa-eye{{else}}fa-eye-slash{{/if}}"></i>
                              </button>
                            {{/if}}
                            <button type="button" class="combater-intel-remove-false" data-intel-remove-false aria-label="Delete false information" data-tooltip="Delete false information">
                              <i class="fa-solid fa-xmark"></i>
                            </button>
                          </span>
                        {{/each}}
                      </div>
                      <button
                        type="button"
                        class="combater-intel-add-false"
                        data-intel-add-false
                        data-tooltip="{{addFalseInformationLabel}}"
                        aria-label="{{addFalseInformationLabel}}"
                      >
                        <i class="fa-solid fa-plus"></i><span>{{addFalseShortLabel}}</span>
                      </button>
                      <div class="combater-intel-false-draft" data-intel-false-draft hidden>
                        <span class="combater-intel-false-draft-label"><i class="fa-solid fa-triangle-exclamation"></i> {{falseInformationLabel}}</span>
                        <select data-intel-false-fact aria-label="{{falseInformationLabel}}">
                          <option value="">Choose false {{label}} fact</option>
                          {{#each falseOptions}}<option value="{{id}}">{{label}}</option>{{/each}}
                        </select>
                        {{#if falseHasValue}}
                          <label class="combater-intel-false-value">
                            <span>{{#if falseIsDc}}DC{{else}}Value{{/if}}</span>
                            <input type="text" inputmode="numeric" pattern="[0-9]*" data-intel-false-value aria-label="{{#if falseIsDc}}DC{{else}}Value{{/if}}">
                          </label>
                        {{/if}}
                        <button type="button" class="combater-intel-false-confirm" data-intel-false-confirm data-tooltip="{{addFalseConfirmLabel}}" aria-label="{{addFalseConfirmLabel}}"><i class="fa-solid fa-plus"></i></button>
                        <button type="button" class="combater-intel-false-cancel" data-intel-false-cancel data-tooltip="{{cancelFalseLabel}}" aria-label="{{cancelFalseLabel}}"><i class="fa-solid fa-xmark"></i></button>
                      </div>
                      <template data-intel-false-template>
                        <span
                          class="combater-intel-false-chip {{#if falseDefaultRevealed}}is-revealed{{else}}is-prepared{{/if}}"
                          data-intel-false-record
                          data-intel-false-revealed="{{falseDefaultRevealed}}"
                          data-falsedc="{{falseIsDc}}"
                        >
                          <i class="fa-solid fa-triangle-exclamation" aria-hidden="true"></i>
                          <span data-intel-false-chip-label></span>
                          {{#if canRevealFalseInformation}}
                            <button type="button" class="combater-intel-toggle-false {{#if falseDefaultRevealed}}is-revealed{{/if}}" data-intel-toggle-false aria-label="Toggle misinformation visibility" data-tooltip="Toggle misinformation visibility">
                              <i class="fa-solid {{#if falseDefaultRevealed}}fa-eye{{else}}fa-eye-slash{{/if}}"></i>
                            </button>
                          {{/if}}
                          <button type="button" class="combater-intel-remove-false" data-intel-remove-false aria-label="Delete false information" data-tooltip="Delete false information">
                            <i class="fa-solid fa-xmark"></i>
                          </button>
                        </span>
                      </template>
                    </section>
                  {{/each}}
                </div>
                {{#unless @root.singleEntry}}
                <div class="combater-intel-entry-tools">
                  <button
                    type="button"
                    class="combater-intel-reveal-all"
                    data-intel-reveal-all
                    data-tooltip="{{revealAllTooltip}}"
                    aria-label="{{revealAllLabel}}"
                  >
                    <i class="fa-solid fa-check-double"></i>
                    <span>{{revealAllLabel}}</span>
                  </button>
                  {{#if canResetAttempts}}
                    <button
                      type="button"
                      class="combater-intel-reset-attempts"
                      data-intel-reset-attempts="{{index}}"
                      data-tooltip="{{resetAttemptsTooltip}}"
                      aria-label="{{resetAttemptsLabel}}"
                    >
                      <i class="fa-solid fa-rotate-left"></i>
                      <span>{{resetAttemptsLabel}}</span>
                    </button>
                  {{/if}}
                </div>
                {{/unless}}
              </div>
            {{else}}
              <div class="combater-intel-revealed">
                {{#unless hasRevealed}}<p class="combater-intel-unknown">{{noneKnownLabel}}</p>{{/unless}}
                {{#each categories}}
                  {{#if hasValues}}
                  <section class="combater-intel-revealed-section">
                    <h4>{{label}}</h4>
                    {{#if hasValues}}
                      <ul>
                        {{#each revealedItems}}
                          <li class="{{#if isFalse}}is-false-information{{/if}}" {{#if tooltip}}data-tooltip="{{tooltip}}"{{/if}}>
                            {{#if isFalse}}<i class="fa-solid fa-triangle-exclamation"></i>{{/if}}
                            <span>{{label}}</span>
                            {{#if extreme}}<i class="fa-solid {{extremeIcon}} combater-intel-extreme is-{{extreme}}" data-tooltip="{{extremeLabel}}" aria-label="{{extremeLabel}}"></i>{{/if}}
                            {{#if uuid}}<button type="button" class="combater-intel-info" data-intel-ability-info="{{uuid}}" data-tooltip="{{infoLabel}}" aria-label="{{infoLabel}}"><i class="fa-solid fa-circle-info"></i></button>{{/if}}
                          </li>
                        {{/each}}
                      </ul>
                    {{/if}}
                  </section>
                  {{/if}}
                {{/each}}
              </div>
            {{/if}}
          </article>
        {{/each}}
      </div>
    </form>
  {{else}}
    <p class="combater-intel-empty">{{noTargetsLabel}}</p>
  {{/if}}

  <footer class="combater-intel-actions">
    {{#if editable}}
      {{#with singleEntry}}
        <span class="combater-intel-entry-tools is-footer">
          <button type="button" class="combater-intel-reveal-all" data-intel-reveal-all data-tooltip="{{revealAllTooltip}}" aria-label="{{revealAllLabel}}">
            <i class="fa-solid fa-check-double"></i>
            <span>{{revealAllLabel}}</span>
          </button>
          {{#if canResetAttempts}}
            <button type="button" class="combater-intel-reset-attempts" data-intel-reset-attempts="{{index}}" data-tooltip="{{resetAttemptsTooltip}}" aria-label="{{resetAttemptsLabel}}">
              <i class="fa-solid fa-rotate-left"></i>
              <span>{{resetAttemptsLabel}}</span>
            </button>
          {{/if}}
        </span>
      {{/with}}
      <button type="button" class="combater-intel-secondary" data-intel-close>{{cancelLabel}}</button>
      <button type="button" class="combater-intel-primary" data-intel-save data-save-label="{{saveLabel}}" data-save-changes-label="{{saveChangesLabel}}">
        <i class="fa-solid fa-floppy-disk"></i>
        <span data-intel-save-label>{{saveLabel}}</span>
      </button>
    {{else}}
      <button type="button" class="combater-intel-primary" data-intel-close>{{closeLabel}}</button>
    {{/if}}
  </footer>
</div>
